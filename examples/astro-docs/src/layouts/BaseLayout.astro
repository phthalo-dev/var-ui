---
import DocsPage from '@var-ui/docs/DocsPage';
import { defaultThemeClassName } from '@var-ui/core';
import { defaultIconSvg } from '@var-ui/icons/glyphs';
import { docsSearchItems, docsSidebarSections } from '../data/navigation';

const {
  title = 'Example Docs',
  contentWidth = 'default',
  showToc: showTocProp,
} = Astro.props as {
  title?: string;
  contentWidth?: 'default' | 'full';
  showToc?: boolean;
};
---

<DocsPage
  title={title}
  contentWidth={contentWidth}
  showToc={showTocProp}
  themeClassName={defaultThemeClassName}
  topNav={[
    { text: 'Docs', link: '/docs', match: '/docs' },
    {
      text: 'Var UI on GitHub',
      link: 'https://github.com/phthalo-dev/var-ui',
      external: true,
      icon: defaultIconSvg('star'),
      iconOnly: true,
    },
  ]}
  sidebarSections={docsSidebarSections}
  searchItems={docsSearchItems}
  brand={{ heading: 'Example Docs', href: '/' }}
>
  <slot name="head" slot="head" />
  <slot name="toc" slot="toc" />
  <slot />
</DocsPage>

<script>
  import '../../typestyles-entry.ts';
</script>
