{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "customConditions": ["@var-ui/source"]
  },
  "include": [
    "src",
    "astro.config.mjs",
    "vite.config.ts",
    "typestyles-entry.ts",
    "scripts",
    "src/content.config.ts"
  ],
  "exclude": ["dist", "node_modules", ".astro"]
}
