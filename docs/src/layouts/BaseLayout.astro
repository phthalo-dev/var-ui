---
import DocsPage from '../../../packages/docs/src/components/DocsPage.astro';
import { cx } from '@var-ui/astro';
import { codeHljsScope } from '@/styles/codeHighlight';
import { defaultThemeClassName } from '@var-ui/core';
import DocsThemePicker from '../components/DocsThemePicker.astro';
import DocsThemeScript from '../components/DocsThemeScript.astro';
import FrameworkSwitcher from '../components/FrameworkSwitcher.astro';
import {
  componentSidebarSections,
  docsSidebarSections,
  themingSidebarSections,
  topNav as topNavItems,
} from '../data/navigation';
import { buildDocsSearchIndex } from '../lib/search-index';
import { normalizeDocsPath } from '@var-ui/docs/utils';

const {
  title = 'Var UI',
  contentWidth = 'default',
  showToc: showTocProp,
  tocContentSelector,
} = Astro.props as {
  title?: string;
  contentWidth?: 'default' | 'full';
  showToc?: boolean;
  tocContentSelector?: string;
};

const framework = Astro.locals.framework;
const currentPath = normalizeDocsPath(Astro.url.pathname);
const sidebarSections = currentPath.startsWith('/components')
  ? componentSidebarSections
  : currentPath.startsWith('/theming')
    ? themingSidebarSections
    : currentPath.startsWith('/docs')
      ? docsSidebarSections
      : null;

const hljsScopeClass = cx(codeHljsScope().root);
const searchItems = buildDocsSearchIndex();
---

<DocsPage
  title={title}
  contentWidth={contentWidth}
  showToc={showTocProp}
  tocContentSelector={tocContentSelector}
  themeClassName={defaultThemeClassName}
  bodyClassName={hljsScopeClass}
  topNav={topNavItems}
  sidebarSections={sidebarSections}
  searchItems={searchItems}
  brand={{ heading: 'Var UI', href: '/' }}
  tocExtraPaths={['/components']}
  htmlAttributes={{ 'data-framework': framework }}
>
  <DocsThemeScript slot="themeScript" />
  <FrameworkSwitcher slot="tools" />
  <DocsThemePicker slot="themePicker" />
  <slot name="head" slot="head" />
  <slot name="toc" slot="toc" />
  <slot />
</DocsPage>

<script>
  import '../../typestyles-entry.ts';
  import '../scripts/docsToc.ts';
</script>
