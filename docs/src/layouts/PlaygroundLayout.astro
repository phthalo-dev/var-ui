---
import { ClientRouter } from 'astro:transitions';
import { AppShell, cx, Layout, LayoutContent, mergeProps, ThemeScript } from '@var-ui/astro';
import { codeHljsScope } from '@/styles/codeHighlight';
import { playgroundLayout } from '@/styles/playgroundLayout';
import { defaultThemeClassName } from '@var-ui/core';
import { normalizeDocsPath } from '@var-ui/docs/utils';
/*
 * Kit chrome via relative paths so Netlify SSR (Node ESM) does not load workspace `.astro`
 * through package exports (same as BaseLayout).
 */
import DocsMobileMenu from '../../../packages/docs/src/components/DocsMobileMenu.astro';
import DocsTopBar from '../../../packages/docs/src/components/DocsTopBar.astro';
import DocsThemeScript from '../components/DocsThemeScript.astro';
import VarUiWordmark from '../components/VarUiWordmark.astro';
import FrameworkSwitcher from '@var-ui/docs-components/FrameworkSwitcher';
import { topNav as topNavItems } from '../data/navigation';
import { buildDocsSearchIndex } from '../lib/search-index';

const { title = 'Var UI', bleed = false } = Astro.props as {
  title?: string;
  bleed?: boolean;
};
const framework = Astro.locals.framework;
const currentPath = normalizeDocsPath(Astro.url.pathname);
const searchItems = buildDocsSearchIndex();
const hljsScopeClass = cx(codeHljsScope().root);
const frame = playgroundLayout({ bleed });
---

<html lang="en" class={defaultThemeClassName} data-framework={framework}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ThemeScript themeClass={defaultThemeClassName} />
    <DocsThemeScript />
    <link rel="stylesheet" href="/typestyles.css" />
    <ClientRouter />
  </head>
  <body class={cx('docs-body', 'docs-body--playground', hljsScopeClass)}>
    <AppShell variant="wash" height="fill" contentPadding="none" mobileBreakpoint="md">
      <DocsTopBar
        slot="topNav"
        topNav={topNavItems}
        searchItems={searchItems}
        brand={{ heading: 'Var UI', href: '/' }}
        currentPath={currentPath}
      >
        <VarUiWordmark slot="brand" size="header" />
        <FrameworkSwitcher slot="tools" />
      </DocsTopBar>

      <DocsMobileMenu slot="mobileNav" topNav={topNavItems} currentPath={currentPath}>
        <FrameworkSwitcher slot="tools" appearance="iconsAndLabels" />
      </DocsMobileMenu>

      <Layout height="fill" padding="none" className={frame.layout.className}>
        <LayoutContent label="Playground">
          <div {...mergeProps(frame.content)}>
            <slot />
          </div>
        </LayoutContent>
      </Layout>
    </AppShell>
    <script>
      import '../../typestyles-entry.ts';
      import '../scripts/reattachTypestyles.ts';
    </script>
  </body>
</html>
