---
import FontPreload from '../components/FontPreload.astro';
import DocsMarketingPage from '@var-ui/docs/DocsMarketingPage';
import { cx, mergeProps } from '@var-ui/astro';
import { codeHljsScope } from '@/styles/codeHighlight';
import { playgroundLayout } from '@/styles/playgroundLayout';
import { defaultThemeClassName } from '@var-ui/core';
import DocsThemeScript from '../components/DocsThemeScript.astro';
import VarUiWordmark from '../components/VarUiWordmark.astro';
import FrameworkSwitcher from '@var-ui/docs-components/FrameworkSwitcher';
import { topNav as topNavItems } from '../data/navigation';
import { buildDocsSearchIndex } from '../lib/search-index';

const { title = 'Var UI', bleed = false } = Astro.props as {
  title?: string;
  bleed?: boolean;
};
const framework = Astro.locals.framework;
const searchItems = buildDocsSearchIndex();
const frame = playgroundLayout({ bleed });
const hljsScopeClass = cx(codeHljsScope().root);
---

<DocsMarketingPage
  title={title}
  themeClassName={defaultThemeClassName}
  bodyClassName={hljsScopeClass}
  topNav={topNavItems}
  searchItems={searchItems}
  brand={{ heading: 'Var UI', href: '/' }}
  htmlAttributes={{ 'data-framework': framework }}
  fill
>
  <VarUiWordmark slot="brand" size="bar" />
  <VarUiWordmark slot="drawerBrand" size="lockup" />
  <DocsThemeScript slot="themeScript" />
  <FrameworkSwitcher slot="tools" />
  <FrameworkSwitcher slot="drawerTools" appearance="iconsAndLabels" fullWidth />
  <FontPreload slot="head" />
  <div {...mergeProps(frame.content)}>
    <slot />
  </div>
</DocsMarketingPage>

<script>
  import '../../typestyles-entry.ts';
</script>
