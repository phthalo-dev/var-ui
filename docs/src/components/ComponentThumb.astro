---
/**
 * Card thumbnail for the components index: the component's monogram (its capital letters, set in
 * the display face) on an accent stage. Consistent for every component, and static, so the index
 * never renders 100+ live demos (or their headings and overlays) into one page.
 */
import { stage } from '@var-ui/core';
import { combine, mergeProps } from '@var-ui/astro';
import { componentCatalog } from '../styles/componentPage';

type Props = { name: string };

const { name } = Astro.props;
// PascalCase names use their capitals (ButtonGroup → BG); phrases use word initials
// (Getting started → GS); a single word keeps its first two letters (Forms → Fo).
const capitals = name.replace(/[^A-Z]/g, '');
const words = name.split(/\s+/).filter(Boolean);
const monogram = (
  capitals.length >= 2
    ? capitals
    : words.length >= 2
      ? words.map((word) => word[0]?.toUpperCase()).join('')
      : name
).slice(0, 2);
const c = componentCatalog();
---

<div {...combine(stage({ tone: 'accent', fade: 'end' }), c.thumb)} aria-hidden="true">
  <span {...mergeProps(c.monogram)}>{monogram}</span>
</div>
