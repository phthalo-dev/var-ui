---
import { formatCssVarName, getShadowSwatches, groupShadowSwatches } from '@/lib/shadow-tokens';
import { shadowSwatchesStyles } from '@/styles/shadowSwatches';

const shadowGroups = groupShadowSwatches(getShadowSwatches());
const boxShadows = shadowGroups.get('box') ?? [];
const c = shadowSwatchesStyles();
---

<div class={(c.root).className}>
  <section class={(c.section).className} aria-labelledby="box-shadow-heading">
    <h2 id="box-shadow-heading" class={(c.sectionTitle).className}>Box shadows</h2>
    <p class={(c.sectionDescription).className}>
      Compound <code>box-shadow</code> tokens from <code>shadow.xs</code> through
      <code>shadow.xl</code>. Each level layers multiple shadows with a consistent top-left light
      source. Tint is derived from primary text color, so shadows follow light and dark mode
      automatically.
    </p>

    <div class={(c.grid).className} role="list" aria-label="Box shadow tokens">
      {
        boxShadows.map((swatch) => (
          <div class={(c.card).className} role="listitem" title={swatch.defaultValue}>
            <div class={(c.preview).className}>
              <div
                class={(c.previewSurface).className}
                style={{ boxShadow: swatch.cssVar }}
                aria-hidden="true"
              />
            </div>
            <div class={(c.meta).className}>
              <span class={(c.token).className}>{swatch.token.replace('shadow.', '')}</span>
              <span class={(c.cssVar).className}>{formatCssVarName(swatch.cssVar)}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

</div>
