---
import { Badge, Heading, Text } from '@var-ui/astro';
import type { ComponentEntry } from '../data/components';
import type { ComponentSourceLink } from '../lib/component-page';

type Props = {
  entry: ComponentEntry;
  categoryLabel?: string;
  sourceLinks: ComponentSourceLink[];
};

const { entry, categoryLabel, sourceLinks } = Astro.props;
---

<header class="component-page-header">
  <div class="component-page-header__meta">
    {categoryLabel ? <Badge tone="neutral">{categoryLabel}</Badge> : null}
  </div>
  <Heading level={1} size="display" className="component-page-header__title">
    {entry.name}
  </Heading>
  <Text tone="secondary" className="component-page-header__description">
    {entry.description}
  </Text>
  {
    sourceLinks.length > 0 ? (
      <div class="component-page-header__links">
        {
          sourceLinks.map((link) => (
            <a class="component-page-header__link" href={link.href} target="_blank" rel="noreferrer">
              {link.label} source
              <span class="component-page-header__link-icon" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>
    ) : null
  }
</header>

<style>
  .component-page-header {
    margin-block-end: 1.5rem;
  }

  .component-page-header__meta {
    margin-block-end: 0.75rem;
  }

  .component-page-header__title {
    margin: 0;
  }

  .component-page-header__description {
    margin-block: 0.5rem 0;
    max-width: 42rem;
  }

  .component-page-header__links {
    display: none;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1rem;
  }

  .component-page-header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid color-mix(in oklab, currentColor 18%, transparent);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    transition: background-color 120ms ease;
  }

  .component-page-header__link:hover {
    background: color-mix(in oklab, currentColor 8%, transparent);
  }

  .component-page-header__link-icon {
    font-size: 0.8em;
    opacity: 0.7;
  }
</style>
