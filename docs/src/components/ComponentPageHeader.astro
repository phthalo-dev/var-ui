---
import DocsPageHeader, { type DocsPageHeaderMeta } from '@var-ui/docs/DocsPageHeader';
import { markdownHref } from '@var-ui/docs/utils';
import DemoPreview from './DemoPreview.astro';
import HeroShowcase, { hasHeroShowcase } from './HeroShowcase';
import { heroDemoId } from '../lib/hero-demo';
import type { ComponentEntry } from '../data/components';
import type { ComponentSourceLink } from '../lib/component-page';
import { svg as githubSvg } from '@var-ui/icons/glyphs/github';
import { svg as boxSvg } from '@var-ui/icons/glyphs/box';
import { svg as markdownSvg } from '@var-ui/icons/glyphs/markdown';

type Props = {
  entry: ComponentEntry;
  categoryLabel?: string;
  sourceLinks: ComponentSourceLink[];
  /** Page tabs, mirrored in the collapsed header bar. */
  tabs?: readonly { id: string; label: string }[];
  selectedTab?: string;
};

const { entry, categoryLabel, sourceLinks, tabs, selectedTab } = Astro.props;
const framework = Astro.locals.framework;

const icons = { source: githubSvg, package: boxSvg, markdown: markdownSvg };

const packageName =
  framework === 'astro' ? '@var-ui/astro' : framework === 'html' ? '@var-ui/core' : '@var-ui/react';
const mdHref = markdownHref(Astro.url.pathname, ['/components']);
const heroId = heroDemoId(entry.slug);

const importCode = framework !== 'html' ? `import { ${entry.name} } from '${packageName}';` : undefined;
const meta: DocsPageHeaderMeta[] = [];
if (sourceLinks.length > 0) {
  meta.push({
    label: 'Source',
    icon: icons.source,
    links: sourceLinks.map((link) => ({ label: link.label, href: link.href })),
  });
}
// The package icon labels this item; dropping the word keeps the row on one line.
meta.push({ icon: icons.package, code: packageName });
if (mdHref) {
  meta.push({ icon: icons.markdown, links: [{ label: 'View as Markdown', href: mdHref }] });
}
---

<DocsPageHeader
  title={entry.name}
  eyebrow={categoryLabel}
  lead={entry.description}
  importCode={importCode}
  meta={meta}
  tabs={tabs}
  selectedTab={selectedTab}
>
  {
    hasHeroShowcase(entry.slug) ? (
      <HeroShowcase slot="preview" slug={entry.slug} />
    ) : heroId ? (
      <DemoPreview slot="preview" id={heroId} />
    ) : null
  }
</DocsPageHeader>
