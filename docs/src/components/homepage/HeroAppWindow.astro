---
/**
 * Hero product window: a small billing screen built from Var UI components, annotated like a
 * design spec with the tokens that style it. Decorative (the same components are live further
 * down), so it is `aria-hidden` and `inert`.
 */
import {
  Avatar,
  Badge,
  Button,
  Meter,
  ProgressBar,
  SegmentedControl,
  SideNav,
  SideNavItem,
  SideNavSection,
  Text,
  combine } from '@var-ui/astro';
import { homeAppWindow } from '../../styles/homeAppWindow';

const w = homeAppWindow();
---

<div {...combine(w.stage)} aria-hidden="true" inert>
  <span {...combine(w.spec, w.specTopLeft)}>--radius-xl: <span {...combine(w.specValue)}>16px</span></span>
  <span {...combine(w.spec, w.specRight)}>
    <span {...combine(w.specSwatch)}></span>--color-accent
  </span>
  <span {...combine(w.spec, w.specLeft)} data-side="left">
    --space-lg: <span {...combine(w.specValue)}>24px</span>
    <span {...combine(w.specLine)}></span>
  </span>
  <span {...combine(w.spec, w.specBottom)}>--shadow-xl</span>

  <div {...combine(w.window)}>
    <div {...combine(w.titlebar)}>
      <span {...combine(w.dots)}>
        <span {...combine(w.dot)}></span><span {...combine(w.dot)}></span><span {...combine(w.dot)}></span>
      </span>
      <span {...combine(w.url)}>northwind.app/settings/billing</span>
      <span {...combine(w.titlebarEnd)}><Avatar name="Maya Okafor" size="sm" /></span>
    </div>
    <div {...combine(w.body)}>
      <SideNav label="Workspace" className={w.sidebar.className}>
        <Text as="span" size="xs" tone="secondary" weight="semibold" eyebrow className={w.sidebarLabel.className}>
          Northwind
        </Text>
        <SideNavSection>
          <SideNavItem label="Overview" />
          <SideNavItem label="Projects" />
          <SideNavItem label="Members" />
          <SideNavItem label="Billing" selected />
          <SideNavItem label="Settings" />
        </SideNavSection>
      </SideNav>
      <div {...combine(w.main)}>
        <div {...combine(w.mainHeader)}>
          <div>
            <p {...combine(w.title)}>Billing</p>
            <Text size="sm" tone="secondary">Choose a plan for 12 seats</Text>
          </div>
          <SegmentedControl
            aria-label="Billing period"
            defaultValue="annual"
            size="sm"
            options={[
              { value: 'monthly', label: 'Monthly' },
              { value: 'annual', label: 'Annual · save 20%' },
            ]}
          />
        </div>
        <div {...combine(w.plans)}>
          <div {...combine(w.plan)}>
            <span {...combine(w.planName)}>Starter</span>
            <p {...combine(w.price)}>$0<span {...combine(w.priceUnit)}> / seat</span></p>
            <Text size="sm" tone="secondary">3 projects, community support</Text>
            <Button size="sm" appearance="outline" pill>Current plan</Button>
          </div>
          <div {...combine(w.plan, w.planSelected)}>
            <span {...combine(w.planName)}>Pro <Badge tone="accent" appearance="solid">Popular</Badge></span>
            <p {...combine(w.price)}>$19<span {...combine(w.priceUnit)}> / seat</span></p>
            <Text size="sm" tone="secondary">Unlimited projects, custom themes</Text>
            <Button size="sm" tone="accent" appearance="filled" pill>Upgrade to Pro</Button>
          </div>
        </div>
        <div {...combine(w.usage)}>
          <ProgressBar label="Seats" value={8} maxValue={12} showValueText />
          <Meter label="Storage" value={64} valueLabel="64 GB" tone="accent" />
        </div>
      </div>
    </div>
  </div>
</div>
