---
/**
 * Two crossing ribbons of real custom properties (see `homeRibbons`). Token values are
 * filled in from the page's computed styles, so they always match the live theme.
 */
import { cx } from '@var-ui/astro';
import { homeRibbons } from '../../styles/homeRibbons';

type Fact = { property: string; value: string };
type Props = { facts: Fact[] };
const { facts } = Astro.props;
const r = homeRibbons();

/** Tokens shown on the phthalo ribbon; `swatch` ones get a color chip. */
const tokens = [
  { name: '--var-ui-color-tone-accent-background', swatch: true },
  { name: '--var-ui-radius-lg' },
  { name: '--var-ui-color-tone-success-foreground', swatch: true },
  { name: '--var-ui-space-lg' },
  { name: '--var-ui-color-code-attr', swatch: true },
  { name: '--var-ui-fontWeight-semibold' },
  { name: '--var-ui-color-tone-danger-foreground', swatch: true },
  { name: '--var-ui-letterSpacing-display' },
];
---

<section class={cx(r.root)} aria-label="Var UI in numbers">
  <div class={cx(r.ribbon, r.ribbonTokens)} aria-hidden="true">
    <div class={cx(r.track)} data-ribbon-track>
      {
        [0, 1].map(() => (
          <ul class={cx(r.list)}>
            {tokens.map((token) => (
              <li class={cx(r.item)}>
                {token.swatch ? (
                  <span class={cx(r.swatch)} data-ribbon-swatch={token.name} />
                ) : null}
                <span class={cx(r.prop)}>{token.name}:</span>
                <span class={cx(r.value)} data-ribbon-token={token.name}>…</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <div class={cx(r.ribbon, r.ribbonFacts)}>
    <div class={cx(r.track)} data-ribbon-track>
      {
        [false, true].map((duplicate) => (
          <ul class={cx(r.list)} aria-hidden={duplicate ? 'true' : undefined}>
            {facts.map((fact) => (
              <li class={cx(r.item)}>
                <span class={cx(r.prop)}>{fact.property}:</span>
                <span class={cx(r.value)}>{fact.value}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  /** Print the live :root values into the token ribbon. */
  function fillRibbons() {
    const style = getComputedStyle(document.documentElement);
    for (const el of document.querySelectorAll<HTMLElement>('[data-ribbon-token]')) {
      const value = style.getPropertyValue(el.dataset.ribbonToken!).trim();
      el.textContent = value.length > 26 ? `${value.slice(0, 25)}…` : value;
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-ribbon-swatch]')) {
      el.style.backgroundColor = `var(${el.dataset.ribbonSwatch})`;
    }
  }
  fillRibbons();
  document.addEventListener('astro:page-load', fillRibbons);
  // Color mode changes swap the token values; re-read them.
  new MutationObserver(fillRibbons).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-color-mode', 'class'],
  });
</script>
