---
export const prerender = false;

import PlaygroundLayout from '../../layouts/PlaygroundLayout.astro';
import ColorSwatches from '../../components/ColorSwatches.astro';
import { findMdxModule } from '../../lib/loadMdx';
import { proseContent } from '@var-ui/core';
import { mergeProps } from '@var-ui/astro';
import { playgroundShellStyles } from '../../styles/playgroundShell';

const slug = Astro.params.slug;
if (!slug || slug === 'index') {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const modules = import.meta.glob('../../../content/playground/*.mdx');
const loader = findMdxModule(modules, slug);
if (!loader) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { Content, frontmatter } = await loader();
const prose = proseContent();
const shell = playgroundShellStyles();
---

<PlaygroundLayout title={`${frontmatter.title} · Var UI`}>
  <article {...mergeProps(prose.root, shell.article.className, 'docs-article')}>
    <Content components={{ ColorSwatches }} />
  </article>
</PlaygroundLayout>
