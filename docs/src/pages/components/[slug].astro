---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ButtonConfigurator from '../../components/ButtonConfigurator.astro';
import ComponentDocTabs from '@var-ui/docs-components/ComponentDocTabs';
import ComponentPageHeader from '../../components/ComponentPageHeader.astro';
import ComponentStylesPanel from '../../components/ComponentStylesPanel.astro';
import DemoHost from '../../components/DemoHost.astro';
import HiddenPropsTable from '@var-ui/docs-components/HiddenPropsTable';
import PropsTable from '../../components/PropsTable.astro';
import { mergeProps, combine } from '@var-ui/astro';
import ComponentPageRails from '../../components/ComponentPageRails.astro';
import { proseContent } from '@var-ui/core';
import { componentDocArticle } from '../../styles/componentPage';
import {
  getComponentCategoryLabel,
  getComponentDocTabs,
  getComponentEntry,
  getComponentSourceLinks,
  hasComponentPlayground,
  parseComponentDocTab,
} from '../../lib/component-page';
import { findMdxModule } from '../../lib/loadMdx';

const slug = Astro.params.slug;
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const modules = import.meta.glob('../../../content/components/*.mdx');
const loader = findMdxModule(modules, slug);
if (!loader) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const entry = getComponentEntry(slug);
if (!entry) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { Content, frontmatter } = await loader();
const categoryLabel = getComponentCategoryLabel(slug);
const sourceLinks = getComponentSourceLinks(slug);
const docTabs = getComponentDocTabs(slug);
const initialTab = parseComponentDocTab(
  Astro.url.searchParams.get('tab') ?? Astro.url.hash.replace(/^#/, ''),
  slug,
);
const prose = proseContent();
const article = componentDocArticle();
const tocContentSelector = "[data-panel='documentation']";
---

<BaseLayout
  title={`${frontmatter.title} · Var UI`}
  showToc
  tocContentSelector={tocContentSelector}
>
  <ComponentPageHeader
    entry={entry}
    categoryLabel={categoryLabel}
    sourceLinks={sourceLinks}
    tabs={docTabs}
    selectedTab={initialTab}
  />

  <ComponentDocTabs tabs={docTabs} defaultSelectedId={initialTab}>
    <div slot="documentation">
      <article {...combine(prose.root, article.root)} data-panel="documentation">
        <Content components={{ Demo: DemoHost, PropsTable: HiddenPropsTable }} />
      </article>
    </div>
    {
      hasComponentPlayground(slug) ? (
        <div slot="playground">
          <section {...mergeProps(article.panel)} data-panel="playground" aria-label="Playground">
            {slug === 'button' ? <ButtonConfigurator /> : null}
          </section>
        </div>
      ) : null
    }
    <div slot="props">
      <section {...mergeProps(article.panel)} data-panel="props" aria-label="Props">
        <PropsTable slug={slug} />
      </section>
    </div>
    <div slot="styles">
      <section {...combine(prose.root, article.panel)} data-panel="styles" aria-label="Styles">
        <ComponentStylesPanel slug={slug} />
      </section>
    </div>
  </ComponentDocTabs>

  <ComponentPageRails
    slot="toc"
    slug={slug}
    initialTab={initialTab}
    hasPlayground={hasComponentPlayground(slug)}
    tocContentSelector={tocContentSelector}
  />
</BaseLayout>

<script>
  import '@var-ui/docs-components/scripts/componentPageTabs';
</script>
