---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import DocsPageHeader from '@var-ui/docs/DocsPageHeader';
import ComponentThumb from '../../components/ComponentThumb.astro';
import { Card, Grid, mergeProps } from '@var-ui/astro';
import { categoryLabels, componentRegistry, type ComponentCategory } from '../../data/components';
import { componentCatalog } from '../../styles/componentPage';
import { findMdxModule } from '../../lib/loadMdx';

const modules = import.meta.glob('../../../content/components/*.mdx');
const loader = findMdxModule(modules, 'index');
if (!loader) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { frontmatter } = await loader();
const categories = (Object.keys(categoryLabels) as ComponentCategory[])
  .map((category) => ({
    id: category,
    label: categoryLabels[category],
    entries: componentRegistry
      .filter((entry) => entry.category === category)
      .sort((a, b) => a.name.localeCompare(b.name)),
  }))
  .filter((group) => group.entries.length > 0);
const catalog = componentCatalog();
---

<BaseLayout title={`${frontmatter.title} · Var UI`} showToc>
  <DocsPageHeader
    title="Components"
    eyebrow={`${componentRegistry.length} components`}
    lead={frontmatter.description}
  />
  <article {...mergeProps(catalog.root, 'docs-article')}>
    {
      categories.map((group) => (
        <section {...mergeProps(catalog.section)}>
          <header {...mergeProps(catalog.header)}>
            <h2 id={group.id} {...mergeProps(catalog.heading)}>
              {group.label}
            </h2>
            <span {...mergeProps(catalog.count)}>{group.entries.length}</span>
          </header>
          <Grid columns="auto" minColumnWidth="15rem" gap="sm">
            {group.entries.map((entry) => (
              <Card
                href={`/components/${entry.slug}`}
                title={entry.name}
                description={entry.description}
                className={catalog.card.className}
              >
                <ComponentThumb slot="media" name={entry.name} />
              </Card>
            ))}
          </Grid>
        </section>
      ))
    }
  </article>
</BaseLayout>
