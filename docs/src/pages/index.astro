---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import HomepageIsland from '../components/homepage/HomepageIsland';
import InstallCommand from '../components/homepage/InstallCommand';
import VarUiWordmark from '../components/VarUiWordmark.astro';
import homepagePreloads from 'virtual:homepage-preloads';
import HeroAppWindow from '../components/homepage/HeroAppWindow.astro';
import LiveInspector from '../components/homepage/LiveInspector';
import KeyboardDemo from '../components/homepage/KeyboardDemo';
import { Button, Code, Heading, Text, combine } from '@var-ui/astro';
import VariableRibbons from '../components/homepage/VariableRibbons.astro';
import TokenCascade from '../components/homepage/TokenCascade.astro';
import { SPECTRUM_STEPS, homeSpectrum } from '../styles/homeSpectrum';
import { componentRegistry } from '../data/components';
import { docsThemePresets } from '../themes/presets';
import { homePage } from '../styles/homePage';

const hp = homePage();
const installCommand = 'npx @var-ui/cli init';

const sp = homeSpectrum();

/** Project facts written as custom properties for the ticker. */
const facts = [
  { property: '--components', value: `${componentRegistry.length}` },
  { property: '--frameworks', value: '3', note: 'react, astro, html' },
  { property: '--themes', value: `${docsThemePresets.length}` },
  { property: '--hashed-class-names', value: '0' },
  { property: '--wcag', value: 'AA' },
  { property: '--runtime-css-in-js', value: 'none' },
  { property: '--license', value: 'MIT' },
];


---

<MarketingLayout title="Var UI — readable, token-first design system" bleed>
  <Fragment slot="head">
    {homepagePreloads.map((href) => <link rel="modulepreload" href={href} crossorigin />)}
  </Fragment>

  <div {...combine(hp.root)}>
    <header {...combine(hp.hero)}>
      <div {...combine(hp.container, hp.heroGrid)}>

        <div {...combine(hp.heroInner)}>
          <VarUiWordmark as="h1" size="hero" />
          <Heading level={2} size="display-sm" weight="light" {...combine(hp.tagline)}>
            <span>An open source design system that&apos;s</span>
            <span {...combine(hp.taglineStrong)}>fully customizable and agent ready</span>
          </Heading>
          <div {...combine(hp.heroActions)}>
            <Button href="/docs/getting-started" tone="accent" appearance="filled" size="xl" pill>
              Get started
            </Button>
            <Button href="/components" appearance="outline" size="xl" pill>
              Browse components
            </Button>
          </div>
          <InstallCommand client:idle command={installCommand} />
        </div>

        <HeroAppWindow />
      </div>
    </header>


    <div {...combine(hp.band)}>
    <section {...combine(hp.container, hp.section)} aria-labelledby="home-showcase-heading">
      <div {...combine(hp.sectionHeader)}>
        <Text as="p" size="sm" weight="medium" mono {...combine(hp.eyebrow)}>themes</Text>
        <Heading level={2} size="display-md" id="home-showcase-heading">
          One system. Every theme.
        </Heading>
        <Text size="lg" tone="secondary" {...combine(hp.sectionLead)}>
          Everything below is live <Code nowrap>@var-ui/react</Code>. Pick a theme and the whole product
          UI repaints from CSS variables alone, while the readout shows the values doing the
          work.
        </Text>
      </div>
      <HomepageIsland client:load />
    </section>
    </div>

    <VariableRibbons facts={facts} />

    <section {...combine(hp.container, hp.section)} aria-labelledby="home-why-heading">
      <div {...combine(hp.sectionHeader)}>
        <Heading level={2} size="display-md" id="home-why-heading" {...combine(hp.headingLines)}>
          <span>Readable CSS. Real tokens.</span>
          <span>Any framework.</span>
        </Heading>
        <Text size="lg" tone="secondary" {...combine(hp.sectionLead)}>
          Three proofs, all running on this page: read the rules a component emits, re-point
          the variable behind them, then drive the controls without a mouse.
        </Text>
      </div>

      <div {...combine(hp.features)}>
        <article {...combine(hp.feature, hp.featureWide)}>
          <div {...combine(hp.featureCopyWide)}>
            <Text as="p" size="sm" weight="medium" mono {...combine(hp.eyebrow)}>devtools</Text>
            <Heading level={3} size="display-sm">Inspect it and understand it.</Heading>
            <Text size="lg" tone="secondary" {...combine(hp.sectionLead)}>
              TypeStyles emits named classes and data attributes, not hashed atoms. Flip the props
              on this live button: the panel reads the rules that now match straight from the page&apos;s
              stylesheets.
            </Text>
          </div>
          <LiveInspector client:idle />
        </article>

        <article {...combine(hp.feature, hp.featureWide)}>
          <div {...combine(hp.featureCopyWide)}>
            <Text as="p" size="sm" weight="medium" mono {...combine(hp.eyebrow)}>cascade</Text>
            <Heading level={3} size="display-sm">One variable, every component.</Heading>
            <Text size="lg" tone="secondary" {...combine(hp.sectionLead)}>
              A token feeds a rule you can read, and the rule paints every component that uses
              it. Re-point <Code nowrap>--color-accent</Code> and everything downstream follows, with the
              same names and props in <Code nowrap>@var-ui/react</Code>, <Code nowrap>@var-ui/astro</Code>, or
              plain HTML.
            </Text>
          </div>
          <TokenCascade />
        </article>

        <article {...combine(hp.feature, hp.featureWide)}>
          <div {...combine(hp.featureCopyWide)}>
            <Text as="p" size="sm" weight="medium" mono {...combine(hp.eyebrow)}>a11y</Text>
            <Heading level={3} size="display-sm">Built for the keyboard.</Heading>
            <Text size="lg" tone="secondary" {...combine(hp.sectionLead)}>
              Interactive components sit on React Aria, so focus order, arrow-key navigation,
              roles, names and states come built in. Drive these with the keyboard and watch
              what assistive tech is told.
            </Text>
          </div>
          <KeyboardDemo client:idle />
        </article>
      </div>
    </section>

    <section {...combine(hp.closing)} aria-labelledby="home-closing-heading">
      <div {...combine(sp.root)} aria-hidden="true">
        <div {...combine(sp.anchor)}>
          {SPECTRUM_STEPS.map(() => <span {...combine(sp.ring)} />)}
        </div>
      </div>
      <div {...combine(hp.container, hp.closingInner)}>
        <Heading level={2} size="display-lg" id="home-closing-heading">
          Start with <VarUiWordmark size="inline" />
        </Heading>
        <div {...combine(hp.heroActions)}>
          <Button href="/docs/getting-started" tone="accent" appearance="filled" size="xl" pill>
            Read the docs
          </Button>
          <Button href="/playground" appearance="outline" size="xl" pill>
            Open the playground
          </Button>
        </div>
        <InstallCommand client:visible command={installCommand} />
      </div>
    </section>
  </div>
</MarketingLayout>
