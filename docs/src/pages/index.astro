---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import HomepageIsland from '../components/homepage/HomepageIsland';
import VarUiWordmark from '../components/VarUiWordmark.astro';
import homepagePreloads from 'virtual:homepage-preloads';
import {
  Card,
  ClickableCard,
  CodeBlock,
  Heading,
  Text,
  cx,
  mergeProps,
} from '@var-ui/astro';
import { linkButton } from '@var-ui/core';
import { githubUrl } from '../data/navigation';
import { homePage } from '../styles/homePage';

const framework = Astro.locals.framework;
const hp = homePage();

const features = [
  {
    title: 'TypeStyles-first',
    description:
      'Component recipes and design tokens replace ad-hoc CSS files. Breakpoints, themes, and variants stay type-safe.',
  },
  {
    title: 'Accessibility built in',
    description:
      'React bindings use React Aria Components for keyboard, focus, and screen-reader behavior out of the box.',
  },
  {
    title: 'React, Astro, or HTML',
    description:
      'Ship with @var-ui/react, @var-ui/astro, or core HTML recipes — the same tokens and visuals everywhere.',
  },
  {
    title: 'Theme system',
    description:
      'createDesignTheme() drives color modes, presets, and CSS variables. Swap palettes without rewriting components.',
  },
  {
    title: 'Docs kit',
    description:
      '@var-ui/docs powers this site: search, TOC, markdown views, and optional component catalogs.',
  },
  {
    title: 'Agent-ready CLI',
    description:
      'npx @var-ui/cli init wires AGENTS.md, component search, and generated docs for coding assistants.',
  },
] as const;

const exploreLinks = [
  {
    title: 'Documentation',
    description: 'Installation, providers, and architecture guides for new projects.',
    hint: 'Getting started →',
    href: '/docs/getting-started',
  },
  {
    title: 'Components',
    description: 'Live demos for every exported component with React, Astro, and HTML snippets.',
    hint: 'Browse catalog →',
    href: '/components',
  },
  {
    title: 'Theming',
    description: 'Tokens, themes, color modes, and CSS variables for brand customization.',
    hint: 'Customize →',
    href: '/theming',
  },
  {
    title: 'Playground',
    description: 'Tune tokens and preview themes interactively before committing to a palette.',
    hint: 'Open playground →',
    href: '/playground',
  },
] as const;

const primaryCta = mergeProps(linkButton({ tone: 'accent', appearance: 'filled', size: 'md' }));
const secondaryCta = mergeProps(
  linkButton({ size: 'md' }),
);
---

<MarketingLayout title="Var UI">
  <Fragment slot="head">
    {homepagePreloads.map((href) => <link rel="modulepreload" href={href} crossorigin />)}
  </Fragment>

  <div class={cx(hp.root)}>
    <header class={cx(hp.hero)}>
      <VarUiWordmark as="h1" size="hero" />
      <p class={cx(hp.heroHeadline)}>
        An open source design system that&apos;s fully customizable and agent ready.
      </p>
      <div class={cx(hp.heroActions)}>
        <a href="/docs/getting-started" {...primaryCta}>Get started</a>
        <a href="/components" {...secondaryCta}>Browse components</a>
      </div>
      <p class={cx(hp.heroMeta)}>
        Open source · Built on <a href="/docs/getting-started">React Aria Components</a> and{' '}
        <a href="/theming/tokens">TypeStyles</a> ·{' '}
        <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      </p>
    </header>

    <section class={cx(hp.install)} aria-label="Install">
      <CodeBlock
        variant="terminal"
        language="bash"
        code="pnpm add @var-ui/react @var-ui/core @var-ui/icons react react-dom react-aria-components"
      />
    </section>

    <section class={cx(hp.section)} aria-labelledby="home-why-heading">
      <div class={cx(hp.sectionHeader)}>
        <Heading level={2} size="lg" id="home-why-heading">Why teams choose Var UI</Heading>
        <p class={cx(hp.sectionLead)}>
          Compare us to shadcn, Mantine, or Reshaped: Var UI pairs a typed token system with
          multi-framework output and a docs kit you can fork for your own design system site.
        </p>
      </div>
      <div class={cx(hp.featuresGrid)}>
        {
          features.map((feature) => (
            <Card title={feature.title} className={cx(hp.featureCard)}>
              <Text>{feature.description}</Text>
            </Card>
          ))
        }
      </div>
    </section>

    <section class={cx(hp.showcaseBand)} aria-labelledby="home-showcase-heading">
      <div class={cx(hp.sectionHeader)}>
        <Heading level={2} size="lg" id="home-showcase-heading">See it in action</Heading>
        <p class={cx(hp.sectionLead)}>
          Switch themes and frameworks with the controls below. The same components render as
          React, Astro markup, or core HTML recipes.
        </p>
      </div>
      <HomepageIsland client:load framework={framework} />
    </section>

    <section class={cx(hp.section)} aria-labelledby="home-explore-heading">
      <div class={cx(hp.sectionHeader)}>
        <Heading level={2} size="lg" id="home-explore-heading">Explore</Heading>
        <p class={cx(hp.sectionLead)}>
          Jump into guides, component demos, theming docs, or the interactive playground.
        </p>
      </div>
      <div class={cx(hp.exploreGrid)}>
        {
          exploreLinks.map((link) => (
            <ClickableCard
              title={link.title}
              description={link.description}
              hint={link.hint}
              href={link.href}
              className={cx(hp.exploreCard)}
            />
          ))
        }
      </div>
    </section>
  </div>
</MarketingLayout>
