---
import { checkbox } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

const cb = checkbox();
---

<label {...mergeProps(cb.root)}>
  <input type="checkbox" class="sr-only" />
  <span {...mergeProps(cb.box)}></span>
  <span {...mergeProps(cb.label)}>Accept terms</span>
</label>

<style>
  .sr-only {
    position: absolute;
    width: 0.0625rem;
    height: 0.0625rem;
    padding: 0;
    margin: -0.0625rem;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
