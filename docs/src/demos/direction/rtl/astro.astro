---
import { Breadcrumbs, SideNav, SideNavHeading, SideNavItem, SideNavSection, Text } from '@var-ui/astro';
import { icon } from '@var-ui/core';
import { mergeProps } from '../../../lib/mergeProps';

const chevron = icon({ size: 'sm' });
---
<div dir="rtl">
  <div style="height: 280px; width: 240px; border: 1px solid var(--var-ui-color-border-subtle); border-radius: 8px; overflow: hidden;">
    <SideNav>
      <SideNavHeading slot="header" heading="Docs" />
      <SideNavSection title="Main">
        <SideNavItem label="Overview" href="#overview" selected />
        <SideNavItem label="Hidden" href="#hidden" />
      </SideNavSection>
    </SideNav>
  </div>
  <Breadcrumbs
    items={[
      { id: 'home', label: 'Home', href: '#' },
      { id: 'here', label: 'Current' },
    ]}
  />
  <div style="display: flex; gap: 0.5rem; align-items: center;">
    <span {...mergeProps(chevron)} data-mirror>
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </span>
    <Text>mirrored chevrons</Text>
    <span {...mergeProps(chevron)} data-mirror>
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
  <Text>dir=rtl island</Text>
</div>
