---
import { AppShell, SideNav, SideNavHeading, SideNavItem, Text, TopNav, TopNavItem } from '@var-ui/astro';
---
<div style="height: 220px; border: 1px solid var(--var-ui-color-border-subtle); border-radius: 8px; overflow: hidden;">
  <AppShell>
    <TopNav slot="topNav">
      <TopNavItem label="Home" href="/" selected />
      <TopNavItem label="Docs" href="/docs" />
    </TopNav>
    <SideNav slot="sideNav">
      <SideNavHeading slot="header" heading="Acme" />
      <SideNavItem label="Dashboard" href="/" selected />
      <SideNavItem label="Settings" href="/settings" />
    </SideNav>
    <Text size="sm">Main content</Text>
  </AppShell>
</div>
