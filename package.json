{
  "name": "var-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "verify": "vp run ci",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test run",
    "test:update": "vp test run -u",
    "test:core": "vp test run packages/core",
    "test:core:update": "vp test run packages/core -u",
    "build": "vp run -F @var-ui/core -F @var-ui/react -F @var-ui/icons -F @var-ui/cli build",
    "build:bundle-fixtures": "vp run -F @var-ui/bundle-fixture-button-only -F @var-ui/bundle-fixture-form-kit -F @var-ui/bundle-fixture-date-kit -F @var-ui/example-vite-app build",
    "test:bundle-budgets": "vp run build && vp run build:bundle-fixtures && node scripts/bundle-budget.mjs",
    "test:bundle-budgets:update": "vp run build && vp run build:bundle-fixtures && node scripts/bundle-budget.mjs --update",
    "pack": "vp run -F @var-ui/core -F @var-ui/react -F @var-ui/icons -F @var-ui/cli pack",
    "dev": "vp run @var-ui/example-vite-app#dev",
    "docs:dev": "vp run @var-ui/docs-site#dev",
    "docs:build": "vp run @var-ui/docs-site#build",
    "docs:preview": "vp run @var-ui/docs-site#preview",
    "astro:check": "vp run @var-ui/astro#check && vp run @var-ui/docs#check && vp run @var-ui/docs-components#check && vp run @var-ui/docs-site#check && vp run @var-ui/example-astro-app#check && vp run @var-ui/example-astro-docs#check",
    "ready": "vp check && vp test run && vp run build && vp run test:bundle-budgets",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "@typestyles/eslint-plugin": "^0.4.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.11.1"
}
