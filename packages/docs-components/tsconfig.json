{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@var-ui/icons/glyphs": ["../icons/src/glyphs.ts"],
      "@var-ui/icons/glyphs/*": ["../icons/src/glyph-data/*"]
    }
  },
  "include": [
    "index.ts",
    "schema.ts",
    "src/**/*.ts",
    "src/**/*.astro",
    "src/env.d.ts",
    "src/virtual.d.ts"
  ]
}
