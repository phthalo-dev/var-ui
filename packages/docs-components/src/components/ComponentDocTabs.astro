---
import { tabs as tabsRecipe } from "@var-ui/core";
import { docsPageTabs } from "@var-ui/docs/styles";
import { combine } from "../utils/mergeProps";

type TabDef = { id: string; label: string };

type Props = {
  tabs: TabDef[];
  defaultSelectedId?: string;
  className?: string;
};

const { tabs, defaultSelectedId, className } = Astro.props;
const selected = defaultSelectedId ?? tabs[0]?.id;
const t = tabsRecipe({ appearance: "pill" });
const page = docsPageTabs();

const ICON_ATTRS =
  'viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"';
const tabIcons: Record<string, string> = {
  documentation: `<svg ${ICON_ATTRS}><path d="M4 1.75h5.25L12.5 5v9.25H4z"/><path d="M9 1.75V5.25h3.5M6 8.25h4.25M6 10.75h4.25"/></svg>`,
  playground: `<svg ${ICON_ATTRS}><path d="M2.5 4.5h7M12.5 4.5h1M2.5 11.5h1M6.5 11.5h7"/><circle cx="11" cy="4.5" r="1.5"/><circle cx="5" cy="11.5" r="1.5"/></svg>`,
  props: `<svg ${ICON_ATTRS}><path d="M5.5 4 2 8l3.5 4M10.5 4 14 8l-3.5 4"/></svg>`,
  styles: `<svg ${ICON_ATTRS}><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5c.9 0 1.25-.6 1.25-1.2 0-.8-.75-1.05-.75-1.8 0-.7.55-1.25 1.25-1.25h1.5a3 3 0 0 0 3-3C14.25 4.2 11.45 1.75 8 1.75z"/><circle cx="5" cy="6.5" r=".75" fill="currentColor"/><circle cx="8" cy="4.75" r=".75" fill="currentColor"/><circle cx="11" cy="6.5" r=".75" fill="currentColor"/></svg>`,
};

const panelSlots = await Promise.all(
  tabs.map(async (tab) => ({
    id: tab.id,
    content: Astro.slots.has(tab.id) ? await Astro.slots.render(tab.id) : null,
  })),
);
---

<div data-var-ui-tabs data-component-doc-tabs data-docs-page-tabs {...combine(t.root, page.root, className)}>
  <div role="tablist" aria-label="Page view" {...combine(t.list, page.list)}>
    {tabs.map((tab) => (
      <button
        type="button"
        role="tab"
        id={`tab-${tab.id}`}
        aria-controls={`panel-${tab.id}`}
        aria-selected={tab.id === selected ? "true" : "false"}
        tabindex={tab.id === selected ? 0 : -1}
        data-selected={tab.id === selected ? "" : undefined}
        {...combine(t.tab)}
      >
        {tabIcons[tab.id] ? <Fragment set:html={tabIcons[tab.id]} /> : null}
        {tab.label}
      </button>
    ))}
  </div>

  {tabs.map((tab) => {
    const slotContent = panelSlots.find((panel) => panel.id === tab.id)?.content;
    return (
      <div
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        hidden={tab.id !== selected ? true : undefined}
        {...combine(page.panel)}
      >
        {slotContent ? <Fragment set:html={slotContent} /> : null}
      </div>
    );
  })}
</div>
