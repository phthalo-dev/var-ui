---
import { mergeProps, SegmentedControl } from '@var-ui/astro';
import { icon } from '@var-ui/core';
import type { ControlSize } from '@var-ui/core';
import { DOCS_FRAMEWORKS } from '../framework';
import { FRAMEWORK_META } from '../framework-icons';

type Props = {
  /** @default 'md' */
  size?: ControlSize;
  /** `labels` adds the framework name beside each icon (e.g. in a mobile drawer). @default 'icons' */
  appearance?: 'icons' | 'iconsAndLabels';
  /** Fills the container's width, with equal-width segments (e.g. a drawer footer). @default false */
  fullWidth?: boolean;
  className?: string;
};

const { size = 'md', appearance = 'icons', fullWidth = false, className } = Astro.props;
const framework = Astro.locals.framework;
const iconOnly = appearance === 'icons';
const iconRecipe = mergeProps(icon({ size: size === 'lg' ? 'lg' : size === 'sm' ? 'sm' : 'md' }));

const options = DOCS_FRAMEWORKS.map((value) => ({
  value,
  label: FRAMEWORK_META[value].label,
  ...(iconOnly ? { 'aria-label': FRAMEWORK_META[value].label } : {}),
}));
---

{/* A `SegmentedControl` radio group: one tab stop, arrow keys switch the framework. */}
<SegmentedControl
  options={options}
  defaultValue={framework}
  size={size}
  layout={iconOnly ? 'icon' : 'default'}
  fullWidth={fullWidth}
  className={className}
  aria-label="Documentation framework"
  data-framework-switcher
>
  {/* One static slot per framework: Astro cannot name slots inside a map. */}
  <Fragment slot="react">
    <span {...iconRecipe} aria-hidden="true" set:html={FRAMEWORK_META.react.iconSvg} />
    {iconOnly ? null : FRAMEWORK_META.react.label}
  </Fragment>
  <Fragment slot="astro">
    <span {...iconRecipe} aria-hidden="true" set:html={FRAMEWORK_META.astro.iconSvg} />
    {iconOnly ? null : FRAMEWORK_META.astro.label}
  </Fragment>
  <Fragment slot="html">
    <span {...iconRecipe} aria-hidden="true" set:html={FRAMEWORK_META.html.iconSvg} />
    {iconOnly ? null : FRAMEWORK_META.html.label}
  </Fragment>
</SegmentedControl>

<script>
  import { initFrameworkSwitcher } from '../scripts/frameworkSwitcher';
  initFrameworkSwitcher();
  document.addEventListener('astro:page-load', () => initFrameworkSwitcher());
</script>
