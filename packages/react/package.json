{
  "name": "@var-ui/react",
  "version": "0.14.0",
  "description": "React components for the var-ui design system",
  "homepage": "https://github.com/phthalo-dev/var-ui/tree/main/packages/react#readme",
  "bugs": "https://github.com/phthalo-dev/var-ui/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phthalo-dev/var-ui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@var-ui/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./components/*": {
      "@var-ui/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.mts",
      "import": "./dist/components/*.mjs"
    },
    "./components/index": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node ../../scripts/check-use-client.mjs",
    "pack": "vp pack",
    "dev": "vp pack --watch"
  },
  "devDependencies": {
    "@hookform/resolvers": "catalog:",
    "@internationalized/date": "catalog:",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@var-ui/core": "workspace:*",
    "@var-ui/icons": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "jsdom": "^26.0.0",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "typestyles": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@internationalized/date": "catalog:",
    "@var-ui/core": "workspace:>=0.1.0 <1.0.0",
    "@var-ui/icons": "workspace:>=0.1.0 <1.0.0",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "typestyles": "catalog:"
  },
  "peerDependenciesMeta": {
    "@var-ui/icons": {
      "optional": true
    }
  }
}
