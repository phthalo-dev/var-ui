{
  "name": "@var-ui/core",
  "version": "0.6.0",
  "description": "Framework-agnostic design tokens and component styles for var-ui",
  "homepage": "https://github.com/phthalo-dev/var-ui/tree/main/packages/core#readme",
  "bugs": "https://github.com/phthalo-dev/var-ui/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phthalo-dev/var-ui.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/theme/base-styles.mjs",
    "./dist/theme/register-default.mjs",
    "./dist/styles.mjs",
    "./dist/styles.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./theme-constants": {
      "types": "./dist/theme/constants.d.mts",
      "import": "./dist/theme/constants.mjs"
    },
    "./register-default-theme": {
      "types": "./dist/theme/register-default.d.mts",
      "import": "./dist/theme/register-default.mjs"
    },
    "./styles": {
      "types": "./dist/styles.d.mts",
      "import": "./dist/styles.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./components/*": {
      "types": "./dist/components/*.d.mts",
      "import": "./dist/components/*.mjs"
    },
    "./components/index": null,
    "./shared/*": {
      "types": "./dist/shared/*.d.mts",
      "import": "./dist/shared/*.mjs"
    },
    "./tokens/declare": {
      "types": "./dist/tokens/declare.d.mts",
      "import": "./dist/tokens/declare.mjs"
    },
    "./icons/iconNames": {
      "types": "./dist/icons/iconNames.d.mts",
      "import": "./dist/icons/iconNames.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/generate-styles-css.mjs",
    "pack": "vp pack && node scripts/generate-styles-css.mjs",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "typestyles": "catalog:"
  },
  "devDependencies": {
    "@typestyles/build-runner": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
