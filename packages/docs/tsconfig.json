{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "customConditions": ["@var-ui/source"]
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.astro", "src/env.d.ts", "src/virtual.d.ts"]
}
