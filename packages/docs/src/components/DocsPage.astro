---
import { ClientRouter } from 'astro:transitions';
import {
  AppShell,
  ColorModeToggle,
  cx,
  Layout,
  LayoutContent,
  LayoutPanel,
  MobileNav,
  MobileNavToggle,
  mergeProps,
  SideNav,
  SideNavItem,
  SideNavSection,
  ThemeScript,
  TopNav,
  TopNavHeading,
  TopNavItem,
} from '@var-ui/astro';
import { docsTopNav } from '../styles/docsTopNav';
import { docsPage, docsPageContent } from '../styles/docsPage';
import DocsSearch from './DocsSearch.astro';
import DocsSidebar from './DocsSidebar.astro';
import DocsToc from './DocsToc.astro';
import type { DocsBrand, DocsSearchItem, SidebarSection, TopNavItem as TopNavItemType } from '../types';
import config from 'virtual:var-docs/config';
import {
  DOCS_TOC_CONTENT_SELECTOR,
  normalizeDocsPath,
  shouldShowDocsToc,
} from '../utils/docs-toc';
import { markdownHref, markdownPrefixes, resolveMarkdownViews } from '../utils/markdown-href';
import { resolveGuideRouteConfig, stripAstroBase } from '../utils/routing';

const {
  title = 'Docs',
  contentWidth = 'default',
  showToc: showTocProp,
  tocContentSelector = DOCS_TOC_CONTENT_SELECTOR,
  tocExtraPaths = [],
  themeClassName,
  bodyClassName,
  topNav,
  sidebarSections = null,
  searchItems = [],
  brand = { heading: 'Docs', href: '/' },
  htmlAttributes = {},
} = Astro.props as {
  title?: string;
  contentWidth?: 'default' | 'full';
  showToc?: boolean;
  tocContentSelector?: string;
  /** Exact paths that should show auto TOC beyond configured guide prefixes. */
  tocExtraPaths?: readonly string[];
  themeClassName: string;
  bodyClassName?: string;
  topNav: readonly TopNavItemType[];
  sidebarSections?: readonly SidebarSection[] | null;
  searchItems?: readonly DocsSearchItem[];
  brand?: DocsBrand;
  /** Extra attributes on `<html>` (e.g. `data-framework`). */
  htmlAttributes?: Record<string, string | undefined>;
};

const pathname = stripAstroBase(Astro.url.pathname, import.meta.env.BASE_URL);
const currentPath = normalizeDocsPath(pathname);
const views = resolveMarkdownViews(config.markdownViews);
const prefixes = markdownPrefixes(config.routes, views.extraPrefixes);
const mdHref = views.enabled ? markdownHref(currentPath, prefixes) : null;
const hasTocSlot = Astro.slots.has('toc');
const guidePrefixes = resolveGuideRouteConfig(config.routes).map((route) => route.prefix);
const showAutoToc =
  showTocProp === false
    ? false
    : showTocProp === true
      ? true
      : !hasTocSlot &&
        shouldShowDocsToc(currentPath, {
          guidePrefixes,
          extraPaths: tocExtraPaths,
        });
const showTocPanel = hasTocSlot || showAutoToc;
const hasToolsSlot = Astro.slots.has('tools');
const hasThemePickerSlot = Astro.slots.has('themePicker');
const hasThemeScriptSlot = Astro.slots.has('themeScript');
const showMobileNav = topNav.length > 0 || Boolean(sidebarSections);

function isSidebarLinkActive(link: string): boolean {
  return currentPath === normalizeDocsPath(link);
}

const nav = docsTopNav();
const page = docsPage();
const sidebarContent = docsPageContent({
  width: contentWidth === 'full' ? 'full' : 'default',
  placement: 'standalone',
});
const pageBodyContent = docsPageContent({
  width: contentWidth === 'full' ? 'full' : 'default',
  placement: 'inPageBody',
});
const pageBodyDefaultContent = docsPageContent({ placement: 'inPageBody' });
const defaultContent = docsPageContent();
---

<html lang="en" class={themeClassName} {...htmlAttributes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ThemeScript themeClass={themeClassName} />
    {hasThemeScriptSlot ? <slot name="themeScript" /> : null}
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}typestyles.css`} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class={cx('docs-body', bodyClassName)}>
    <AppShell variant="wash" height="fill" contentPadding={0} mobileBreakpoint="md">
      <TopNav slot="topNav" className={cx(nav.root)}>
        <TopNavHeading slot="heading" heading={brand.heading} headingHref={brand.href} />
        {
          topNav.map((item) => (
            <TopNavItem
              label={item.text}
              href={item.link}
              selected={currentPath.startsWith(item.match)}
            />
          ))
        }
        <div slot="end" class={cx(nav.tools)}>
          <div
            class={cx(nav.toolsPersist)}
            transition:persist="docs-top-nav-tools"
            transition:animate="none"
          >
            <DocsSearch items={searchItems} />
            <div class={cx(nav.toolbar)}>
              {hasToolsSlot ? (
                <div class={cx(nav.toolbarExtra)}>
                  <slot name="tools" />
                </div>
              ) : null}
              {hasThemePickerSlot ? <slot name="themePicker" /> : null}
              <ColorModeToggle includeSystem size="md" />
            </div>
          </div>
          {
            showMobileNav ? <MobileNavToggle /> : null
          }
        </div>
      </TopNav>

      {
        showMobileNav ? (
          <MobileNav slot="mobileNav" header="Menu">
            <div class={cx(nav.mobileNavBody)}>
              {
                topNav.length > 0 ? (
                  <SideNavSection>
                    {topNav.map((item) => (
                      <SideNavItem
                        label={item.text}
                        href={item.link}
                        selected={currentPath.startsWith(item.match)}
                      />
                    ))}
                  </SideNavSection>
                ) : null
              }
              {sidebarSections ? (
                <DocsSidebar sections={sidebarSections} isLinkActive={isSidebarLinkActive} />
              ) : null}
            </div>
          </MobileNav>
        ) : null
      }

      {
        sidebarSections ? (
          <Layout height="fill" padding={0} className={cx(page.siteLayout)}>
            <LayoutPanel slot="start" side="start" width={280} hasDivider padding={0} scrollable={false}>
              <SideNav label="Section navigation" collapsible>
                <DocsSidebar sections={sidebarSections} isLinkActive={isSidebarLinkActive} />
              </SideNav>
            </LayoutPanel>
            <LayoutContent label="Main content">
              {
                showTocPanel ? (
                  <div class={cx(page.pageBody)}>
                    <div {...mergeProps(pageBodyContent)}>
                      {mdHref ? (
                        <p>
                          <a href={mdHref}>Also available as Markdown</a>
                        </p>
                      ) : null}
                      <slot />
                    </div>
                    <aside class={cx(page.toc)} aria-label="On this page">
                      {hasTocSlot ? <slot name="toc" /> : <DocsToc contentSelector={tocContentSelector} />}
                    </aside>
                  </div>
                ) : (
                  <div {...mergeProps(sidebarContent)}>
                    {mdHref ? (
                      <p>
                        <a href={mdHref}>Also available as Markdown</a>
                      </p>
                    ) : null}
                    <slot />
                  </div>
                )
              }
            </LayoutContent>
          </Layout>
        ) : (
          <Layout height="fill" padding={showTocPanel ? 0 : 6} className={cx(page.siteLayout)}>
            <LayoutContent label="Main content">
              {
                showTocPanel ? (
                  <div class={cx(page.pageBody)}>
                    <div {...mergeProps(pageBodyDefaultContent)}>
                      {mdHref ? (
                        <p>
                          <a href={mdHref}>Also available as Markdown</a>
                        </p>
                      ) : null}
                      <slot />
                    </div>
                    <aside class={cx(page.toc)} aria-label="On this page">
                      {hasTocSlot ? <slot name="toc" /> : <DocsToc contentSelector={tocContentSelector} />}
                    </aside>
                  </div>
                ) : (
                  <div {...mergeProps(defaultContent)}>
                    {mdHref ? (
                      <p>
                        <a href={mdHref}>Also available as Markdown</a>
                      </p>
                    ) : null}
                    <slot />
                  </div>
                )
              }
            </LayoutContent>
          </Layout>
        )
      }
    </AppShell>
    <script>
      import '../scripts/docsPageClient.ts';
    </script>
  </body>
</html>
