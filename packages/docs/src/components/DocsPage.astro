---
import { svg as markdownSvg } from '@var-ui/icons/glyphs/markdown';
import { ClientRouter } from 'astro:transitions';
import {
  AppShell,
  Layout,
  LayoutContent,
  LayoutPanel,
  mergeProps,
  SideNav,
  ThemeScript, combine } from '@var-ui/astro';
import { docsPage, docsPageContent } from '../styles/docsPage';
import DocsFavicon from './DocsFavicon.astro';
import DocsMobileMenu from './DocsMobileMenu.astro';
import DocsTopBar from './DocsTopBar.astro';
import DocsSidebar from './DocsSidebar.astro';
import DocsToc from './DocsToc.astro';
import type { DocsBrand, DocsSearchItem, SidebarSection, TopNavItem as TopNavItemType } from '../types';
import config from 'virtual:var-docs/config';
import {
  DOCS_TOC_CONTENT_SELECTOR,
  normalizeDocsPath,
  shouldShowDocsToc,
} from '../utils/docs-toc';
import { markdownHref, markdownPrefixes, resolveMarkdownViews } from '../utils/markdown-href';
import { resolveGuideRouteConfig, stripAstroBase } from '../utils/routing';

const {
  title = 'Docs',
  contentWidth = 'default',
  showToc: showTocProp,
  tocHidden = false,
  tocContentSelector = DOCS_TOC_CONTENT_SELECTOR,
  tocExtraPaths = [],
  themeClassName,
  bodyClassName,
  topNav,
  sidebarSections = null,
  searchItems = [],
  brand = { heading: 'Docs', href: '/' },
  htmlAttributes = {},
} = Astro.props as {
  title?: string;
  contentWidth?: 'default' | 'full';
  showToc?: boolean;
  /** Render the TOC rail hidden at first paint (a script reveals it; e.g. non-default tabs). */
  tocHidden?: boolean;
  tocContentSelector?: string;
  /** Exact paths that should show auto TOC beyond configured guide prefixes. */
  tocExtraPaths?: readonly string[];
  themeClassName: string;
  bodyClassName?: string;
  topNav: readonly TopNavItemType[];
  sidebarSections?: readonly SidebarSection[] | null;
  searchItems?: readonly DocsSearchItem[];
  brand?: DocsBrand;
  /** Extra attributes on `<html>` (e.g. `data-framework`). */
  htmlAttributes?: Record<string, string | undefined>;
};

const pathname = stripAstroBase(Astro.url.pathname, import.meta.env.BASE_URL);
const currentPath = normalizeDocsPath(pathname);
const views = resolveMarkdownViews(config.markdownViews);
const prefixes = markdownPrefixes(config.routes, views.extraPrefixes);
const mdHref = views.enabled ? markdownHref(currentPath, prefixes) : null;
// Layouts forward `toc` unconditionally, so judge the slot by what it renders, not by presence.
const tocSlotHtml = Astro.slots.has('toc') ? (await Astro.slots.render('toc')).trim() : '';
const hasTocSlot = tocSlotHtml.length > 0;
const guidePrefixes = resolveGuideRouteConfig(config.routes).map((route) => route.prefix);
const showAutoToc =
  showTocProp === false
    ? false
    : showTocProp === true
      ? true
      : !hasTocSlot &&
        shouldShowDocsToc(currentPath, {
          guidePrefixes,
          extraPaths: tocExtraPaths,
        });
const showTocPanel = hasTocSlot || showAutoToc;
const hasToolsSlot = Astro.slots.has('tools');
// Extra rail content above the TOC (e.g. a landing page's "Start here" links).
const hasRailSlot = Astro.slots.has('rail');
const hasDrawerToolsSlot = Astro.slots.has('drawerTools');
const hasBrandSlot = Astro.slots.has('brand');
/** `drawerBrand`: the drawer header's brand (e.g. a full lockup where the bar shows a mark); falls back to `brand`. */
const hasDrawerBrandSlot = Astro.slots.has('drawerBrand');
const hasThemeScriptSlot = Astro.slots.has('themeScript');
const showMobileNav = topNav.length > 0 || Boolean(sidebarSections);

function isSidebarLinkActive(link: string): boolean {
  return currentPath === normalizeDocsPath(link);
}

const page = docsPage();
const sidebarContent = docsPageContent({
  width: contentWidth === 'full' ? 'full' : 'default',
  placement: 'standalone',
});
const pageBodyContent = docsPageContent({
  width: contentWidth === 'full' ? 'full' : 'default',
  placement: 'inPageBody',
});
const pageBodyDefaultContent = docsPageContent({ placement: 'inPageBody' });
const defaultContent = docsPageContent();
---

<html lang="en" class={themeClassName} {...htmlAttributes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <DocsFavicon />
    <ThemeScript themeClass={themeClassName} />
    {hasThemeScriptSlot ? <slot name="themeScript" /> : null}
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}typestyles.css`} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body {...combine('docs-body', bodyClassName)}>
    <AppShell
      variant="wash"
      height="fill"
      contentPadding="none"
      mobileBreakpoint={sidebarSections ? 'lg' : 'md'}
    >
      <DocsTopBar
        slot="topNav"
        topNav={topNav}
        searchItems={searchItems}
        brand={brand}
        currentPath={currentPath}
        mobileNav={showMobileNav}
      >
        {hasBrandSlot ? <slot name="brand" slot="brand" /> : null}
        {hasToolsSlot ? <slot name="tools" slot="tools" /> : null}
      </DocsTopBar>

      {
        showMobileNav ? (
          <DocsMobileMenu slot="mobileNav" topNav={topNav} currentPath={currentPath} brand={brand}>
            {hasDrawerBrandSlot ? (
              <slot name="drawerBrand" slot="brand" />
            ) : hasBrandSlot ? (
              <slot name="brand" slot="brand" />
            ) : null}
            {sidebarSections ? (
              <DocsSidebar sections={sidebarSections} isLinkActive={isSidebarLinkActive} />
            ) : null}
            {hasDrawerToolsSlot ? <slot name="drawerTools" slot="tools" /> : null}
          </DocsMobileMenu>
        ) : null
      }

      {
        sidebarSections ? (
          <Layout height="fill" padding="none" {...combine(page.siteLayout)}>
            <LayoutPanel
              slot="start"
              side="start"
              width={280}
              hasDivider
              padding="none"
              scrollable={false}
              {...mergeProps(page.sidebar)}
            >
              <SideNav label="Section navigation" collapsible>
                <DocsSidebar sections={sidebarSections} isLinkActive={isSidebarLinkActive} />
              </SideNav>
            </LayoutPanel>
            <LayoutContent label="Main content" className={page.main.className}>
              {
                showTocPanel ? (
                  <div {...mergeProps(page.pageBody)}>
                    <div {...mergeProps(pageBodyContent)} data-docs-content>
                      <slot />
                    </div>
                    <aside
                      {...mergeProps(page.toc)}
                      aria-label="On this page"
                      data-docs-toc-slot
                      hidden={tocHidden || undefined}
                    >
                      {hasRailSlot ? <slot name="rail" /> : null}
                      {hasTocSlot ? <Fragment set:html={tocSlotHtml} /> : <DocsToc contentSelector={tocContentSelector} />}
                      {mdHref && !hasTocSlot ? (
                        <div {...mergeProps(page.tocActions)}>
                          <a {...mergeProps(page.tocAction)} href={mdHref}>
                            <span aria-hidden="true" set:html={markdownSvg} />
                            View as Markdown
                          </a>
                        </div>
                      ) : null}
                    </aside>
                  </div>
                ) : (
                  <div {...mergeProps(sidebarContent)}>
                    <slot />
                  </div>
                )
              }
            </LayoutContent>
          </Layout>
        ) : (
          <Layout height="fill" padding={showTocPanel ? 'none' : 'xl'} {...combine(page.siteLayout)}>
            <LayoutContent label="Main content" className={page.main.className}>
              {
                showTocPanel ? (
                  <div {...mergeProps(page.pageBody)}>
                    <div {...mergeProps(pageBodyDefaultContent)} data-docs-content>
                      <slot />
                    </div>
                    <aside
                      {...mergeProps(page.toc)}
                      aria-label="On this page"
                      data-docs-toc-slot
                      hidden={tocHidden || undefined}
                    >
                      {hasRailSlot ? <slot name="rail" /> : null}
                      {hasTocSlot ? <Fragment set:html={tocSlotHtml} /> : <DocsToc contentSelector={tocContentSelector} />}
                      {mdHref && !hasTocSlot ? (
                        <div {...mergeProps(page.tocActions)}>
                          <a {...mergeProps(page.tocAction)} href={mdHref}>
                            <span aria-hidden="true" set:html={markdownSvg} />
                            View as Markdown
                          </a>
                        </div>
                      ) : null}
                    </aside>
                  </div>
                ) : (
                  <div {...mergeProps(defaultContent)}>
                    <slot />
                  </div>
                )
              }
            </LayoutContent>
          </Layout>
        )
      }
    </AppShell>
    <script>
      import '../scripts/docsPageClient.ts';
    </script>
  </body>
</html>
