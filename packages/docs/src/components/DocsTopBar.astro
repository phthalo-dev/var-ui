---
/**
 * The docs header: one component for every docs layout (marketing, guide, playground) so the
 * brand, links and controls sit in the same place on every page.
 *
 * It is persisted across view transitions (`transition:persist`): navigating does not re-render
 * or cross-fade it; `docsTopBarClient` moves the selected link instead.
 *
 * Slots: `brand` (custom brand content, e.g. a logo/wordmark), `tools` (extra controls before
 * the appearance menu, e.g. a framework switcher; moved into `DocsMobileMenu` below `md`).
 */
import { MobileNavToggle, TopNav, TopNavHeading, TopNavItem, combine } from '@var-ui/astro';
import { docsTopNav } from '../styles/docsTopNav';
import DocsAppearanceMenu from './DocsAppearanceMenu.astro';
import DocsSearch from './DocsSearch.astro';
import type { DocsBrand, DocsSearchItem, TopNavItem as TopNavItemType } from '../types';
import { selectedTopNavMatch, topNavLinkAttributes } from '../utils/top-nav';

type Props = {
  topNav: readonly TopNavItemType[];
  searchItems?: readonly DocsSearchItem[];
  brand?: DocsBrand;
  /** Normalized current path (without base) used for the selected link. */
  currentPath: string;
  /** Renders the hamburger for `DocsMobileMenu`. @default true */
  mobileNav?: boolean;
};

const {
  topNav,
  searchItems = [],
  brand = { heading: 'Docs', href: '/' },
  currentPath,
  mobileNav = true,
} = Astro.props;

const nav = docsTopNav();
const brandSlotHtml = Astro.slots.has('brand')
  ? (await Astro.slots.render('brand')).trim()
  : '';
const hasBrandSlot = brandSlotHtml.length > 0;
const toolsSlotHtml = Astro.slots.has('tools')
  ? (await Astro.slots.render('tools')).trim()
  : '';
const hasToolsSlot = toolsSlotHtml.length > 0;
const selectedMatch = selectedTopNavMatch(
  topNav.map((item) => item.match),
  currentPath,
);
---

<TopNav
  {...combine(nav.root)}
  data-docs-top-bar
  transition:persist="docs-top-bar"
  transition:animate="none"
>
  {
    hasBrandSlot ? (
      <TopNavHeading slot="heading" heading={brand.heading} headingHref={brand.href} aria-label={brand.heading}>
        <Fragment set:html={brandSlotHtml} />
      </TopNavHeading>
    ) : (
      <TopNavHeading slot="heading" heading={brand.heading} headingHref={brand.href} />
    )
  }
  {
    topNav.map((item) => (
      <TopNavItem
        label={item.text}
        href={item.link}
        iconOnly={Boolean(item.iconOnly && item.icon)}
        selected={item.match !== undefined && item.match === selectedMatch}
        data-docs-top-nav-match={item.match}
        {...topNavLinkAttributes(item)}
      >
        {item.icon ? <Fragment slot="icon" set:html={item.icon} /> : null}
      </TopNavItem>
    ))
  }
  <div slot="end" {...combine(nav.tools)}>
    <DocsSearch items={searchItems} />
    {
      hasToolsSlot ? (
        <div {...combine(nav.toolbarExtra)}>
          <Fragment set:html={toolsSlotHtml} />
        </div>
      ) : null
    }
    <span {...combine(nav.divider)} aria-hidden="true"></span>
    <DocsAppearanceMenu />
    {mobileNav ? <MobileNavToggle /> : null}
  </div>
</TopNav>

<script>
  import { initDocsTopBar } from '../scripts/docsTopBarClient';
  initDocsTopBar();
</script>
