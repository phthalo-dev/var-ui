---
import { proseContent } from '@var-ui/core';
import { mergeProps } from '@var-ui/astro';
import { docsGuideArticle } from '../styles/docsPageHeader';

const { wide = false } = Astro.props as { wide?: boolean };
const prose = proseContent();
const article = docsGuideArticle();
---

<article
  {...mergeProps(prose.root, article.root.className, 'docs-article')}
  data-docs-article
  data-wide={wide || undefined}
>
  <slot />
</article>
