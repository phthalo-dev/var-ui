---
import { docsArticleProse } from '../styles/docsProse';
import { combine } from '@var-ui/astro';
import { docsGuideArticle } from '../styles/docsPageHeader';

const { wide = false } = Astro.props as { wide?: boolean };
const prose = docsArticleProse();
const article = docsGuideArticle();
---

<article
  {...combine(...prose, article.root, { className: 'docs-article' })}
  data-docs-article
  data-wide={wide || undefined}
>
  <slot />
</article>
