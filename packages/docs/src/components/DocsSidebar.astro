---
import { SideNavItem, SideNavSection } from '@var-ui/astro';
import type { SidebarSection } from '../types';

type Props = {
  sections: readonly SidebarSection[];
  isLinkActive: (link: string) => boolean;
};

/** Past this many links the sidebar collapses every group except the current one. */
const COLLAPSE_THRESHOLD = 40;

const { sections, isLinkActive } = Astro.props;
const total = sections.reduce((sum, section) => sum + section.items.length, 0);
const collapsible = sections.length > 1;
---

{
  sections.map((section) => {
    const current = section.items.some((item) => isLinkActive(item.link));
    return (
      <SideNavSection
        title={section.title}
        collapsible={collapsible && section.title != null}
        count={section.items.length}
        defaultOpen={current || total <= COLLAPSE_THRESHOLD}
      >
        {section.items.map((item) => (
          <SideNavItem label={item.text} href={item.link} selected={isLinkActive(item.link)} />
        ))}
      </SideNavSection>
    );
  })
}

