---
import { CommandPalette, SearchInput } from '@var-ui/astro';
import type { DocsSearchItem } from '../types';

type Props = {
  items: readonly DocsSearchItem[];
  placeholder?: string;
  id?: string;
  /** Second line of the "No results" state. */
  emptyHint?: string;
};

const {
  items,
  placeholder = 'Search docs…',
  id: paletteId = 'docs-search',
  emptyHint = "Try a component name like “button”, or a topic like “tokens”.",
} = Astro.props;
---

{/* `.docs-search` is targeted by `docsTopNav` for toolbar flex layout. */}
<div class="docs-search">
  <SearchInput
    variant="command"
    size="md"
    commandPalette={paletteId}
    placeholder={placeholder}
    aria-label={placeholder}
  />
  <CommandPalette
    id={paletteId}
    items={[...items]}
    placeholder={placeholder}
    aria-label={placeholder}
    recentKey={`${paletteId}-recent`}
    emptyHint={emptyHint}
  />
</div>
