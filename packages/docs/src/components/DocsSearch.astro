---
import { CommandPalette, SearchInput } from '@var-ui/astro';
import type { DocsSearchItem } from '../types';

type Props = {
  items: readonly DocsSearchItem[];
  /** Placeholder in the command palette's input. */
  placeholder?: string;
  /** Placeholder on the bar's search trigger: short, so it fits the tablet-width bar. */
  triggerPlaceholder?: string;
  /** Accessible name of the trigger and the palette. */
  label?: string;
  id?: string;
  /** Second line of the "No results" state. */
  emptyHint?: string;
  /**
   * URL of a JSON array of `{ id, body }` (each page's full text), fetched when search first
   * opens and searched after titles, descriptions, keywords and headings.
   */
  searchIndexUrl?: string;
};

const {
  items,
  placeholder = 'Search docs…',
  triggerPlaceholder = 'Search…',
  label = 'Search docs',
  id: paletteId = 'docs-search',
  emptyHint = "Try a component name like “button”, or a topic like “tokens”.",
  searchIndexUrl,
} = Astro.props;
---

{/* `.docs-search` is targeted by `docsTopNav` for toolbar flex layout. */}
<div class="docs-search">
  <SearchInput
    variant="command"
    size="md"
    commandPalette={paletteId}
    placeholder={triggerPlaceholder}
    aria-label={label}
  />
  <CommandPalette
    id={paletteId}
    items={[...items]}
    placeholder={placeholder}
    aria-label={label}
    recentKey={`${paletteId}-recent`}
    emptyHint={emptyHint}
    searchIndexUrl={searchIndexUrl}
  />
</div>
