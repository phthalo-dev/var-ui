---
import CodeBlockLayout from './CodeBlockLayout.astro';

type DemoFramework = 'react' | 'astro' | 'html';

type Props = {
  code: string;
  language?: string;
  filename?: string;
  framework?: DemoFramework;
  title?: string;
  copyable?: boolean;
  showLineNumbers?: boolean;
};

const props = Astro.props as Props;
const defaultSlotHtml = Astro.slots.has('default')
  ? (await Astro.slots.render('default')).trim()
  : '';
const hasPreview = defaultSlotHtml.length > 0;
---

<CodeBlockLayout {...props}>
  {hasPreview ? <Fragment slot="preview" set:html={defaultSlotHtml} /> : null}
</CodeBlockLayout>
