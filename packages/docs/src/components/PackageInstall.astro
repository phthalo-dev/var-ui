---
/**
 * One code block for an install command, with a tab per package manager.
 * `<PackageInstall packages="@var-ui/react @var-ui/core" />` · `dev` for devDependencies ·
 * `commands` for commands that are not a plain install (`[{ id: 'pnpm', command: '…' }]`).
 * The same markup as `packageInstallMarkup()` from `@var-ui/docs/package-install`.
 */
import {
  nextPackageInstallId,
  packageInstallCommands,
  packageInstallMarkup,
  type PackageInstallCommand,
} from '../utils/package-install';

type Props =
  | { packages: string; dev?: boolean; commands?: never }
  | { commands: readonly PackageInstallCommand[]; packages?: never; dev?: never };

const props = Astro.props;
const commands = props.commands ?? packageInstallCommands(props.packages, { dev: props.dev });
// Ids count up per page render, so the HTML is the same on every build.
const html = packageInstallMarkup({ commands, id: nextPackageInstallId(Astro.request) });
---

<Fragment set:html={html} />

<script>
  import { initPackageInstall } from '../scripts/packageInstall';
  initPackageInstall();
  document.addEventListener('astro:page-load', () => initPackageInstall());
</script>
