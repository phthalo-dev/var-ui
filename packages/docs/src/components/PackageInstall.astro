---
/**
 * One code block for an install command, with a tab per package manager.
 * `<PackageInstall packages="@var-ui/react @var-ui/core" />` · `dev` for devDependencies.
 */
import { codeBlock } from '@var-ui/core';
import { mergeProps } from '@var-ui/astro';
import { svg as copySvg } from '@var-ui/icons/glyphs/copy';

type Props = {
  packages: string;
  dev?: boolean;
};

const { packages, dev = false } = Astro.props;
const managers = [
  { id: 'pnpm', command: `pnpm add${dev ? ' -D' : ''} ${packages}` },
  { id: 'npm', command: `npm install${dev ? ' -D' : ''} ${packages}` },
  { id: 'yarn', command: `yarn add${dev ? ' -D' : ''} ${packages}` },
  { id: 'bun', command: `bun add${dev ? ' -d' : ''} ${packages}` },
] as const;
const cb = codeBlock({ variant: 'default' });
const uid = `pkg-${Math.random().toString(36).slice(2, 8)}`;
---

<div {...mergeProps(cb.root)} data-package-install>
  <div {...mergeProps(cb.header)}>
    <div {...mergeProps(cb.tabs)} role="tablist" aria-label="Package manager">
      {
        managers.map((manager, index) => (
          <button
            type="button"
            role="tab"
            id={`${uid}-tab-${manager.id}`}
            aria-controls={`${uid}-panel-${manager.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-package-manager={manager.id}
            {...mergeProps(cb.tab)}
          >
            {manager.id}
          </button>
        ))
      }
    </div>
    <div {...mergeProps(cb.actions)}>
      <button
        type="button"
        {...mergeProps(cb.copyButton)}
        data-var-ui-code-copy
        data-var-ui-code={managers[0].command}
        data-var-ui-copy-label="Copy command"
        data-var-ui-copied-label="Copied"
        data-var-ui-error-label="Copy failed"
        aria-label="Copy command"
      >
        <span data-codeblock-copy-icon set:html={copySvg} />
      </button>
      <span {...mergeProps(cb.feedback)} data-var-ui-codeblock-feedback role="status" aria-live="polite" />
    </div>
  </div>
  <div {...mergeProps(cb.body)}>
    {
      managers.map((manager, index) => (
        <pre
          {...mergeProps(cb.pre)}
          role="tabpanel"
          id={`${uid}-panel-${manager.id}`}
          aria-labelledby={`${uid}-tab-${manager.id}`}
          hidden={index !== 0 || undefined}
        ><code {...mergeProps(cb.code)}>{manager.command}</code></pre>
      ))
    }
  </div>
</div>

<script>
  import { initPackageInstall } from '../scripts/packageInstall';
  initPackageInstall();
  document.addEventListener('astro:page-load', () => initPackageInstall());
</script>
