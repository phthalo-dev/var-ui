---
import CodeDemoCodeBlock from './CodeDemoCodeBlock.astro';
import { Button, combine, Heading, mergeProps } from '@var-ui/astro';
import { svg as darkSvg } from '@var-ui/icons/glyphs/colorModeDark';
import { codeBlock as codeBlockRecipe } from '../styles/codeBlock';
import { stage } from '@var-ui/core';

export type CodeBlockFramework = 'react' | 'astro' | 'html';

export type CodeBlockLayoutProps = {
  code: string;
  language?: string;
  filename?: string;
  /** Shown in the code header badge when set. */
  framework?: CodeBlockFramework;
  title?: string;
  copyable?: boolean;
  showLineNumbers?: boolean;
};

const {
  code,
  language = 'tsx',
  filename,
  framework,
  title,
  copyable = true,
  showLineNumbers,
} = Astro.props as CodeBlockLayoutProps;

const previewSlotHtml = Astro.slots.has('preview')
  ? (await Astro.slots.render('preview')).trim()
  : '';
const hasPreview = previewSlotHtml.length > 0;
const s = codeBlockRecipe();
---

<div {...mergeProps(s.root)} data-code-block>
  {title ? (
    <Heading level={4} size="sm">
      {title}
    </Heading>
  ) : null}
  <div {...mergeProps(s.card)}>
    {
      hasPreview ? (
        <div {...mergeProps(s.stageWrap)}>
          <div {...combine(stage(), s.preview)} data-not-prose data-demo-stage>
            <div {...mergeProps(s.previewInner)} data-demo-stage-inner>
              <Fragment set:html={previewSlotHtml} />
            </div>
          </div>
          <div {...mergeProps(s.toolbar)} role="toolbar" aria-label="Preview options">
            <Button
              size="sm"
              appearance="ghost"
              layout="icon"
              aria-label="Preview in the opposite color mode"
              aria-pressed="false"
              data-demo-toggle="color-mode"
            >
              <span aria-hidden="true" set:html={darkSvg} />
            </Button>
            <Button
              size="sm"
              appearance="ghost"
              aria-label="Preview right-to-left"
              aria-pressed="false"
              data-demo-toggle="direction"
            >
              RTL
            </Button>
          </div>
        </div>
      ) : null
    }
    <section
      {...combine(hasPreview ? s.code : undefined, s.codeBlock)}
      data-code-block-code
      data-demo-code={code}
      {...(framework ? { 'data-demo-framework': framework } : {})}
    >
      <CodeDemoCodeBlock
        code={code}
        language={language}
        filename={filename}
        copyable={copyable}
        showLineNumbers={showLineNumbers}
      />
      <div {...mergeProps(s.codeFade)} data-demo-fade hidden></div>
      <div {...mergeProps(s.expand)} data-demo-expand-wrap hidden>
        <button type="button" {...mergeProps(s.expandButton)} data-demo-expand>
          Show full code
        </button>
      </div>
    </section>
  </div>
</div>

<script>
  import { initCodeBlockExpand } from '../scripts/codeBlockExpand';
  import { initDemoStageToolbar } from '../scripts/demoStageToolbar';
  initCodeBlockExpand();
  initDemoStageToolbar();
</script>
