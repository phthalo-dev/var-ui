---
/**
 * Marketing shell: top nav and search without sidebar or TOC grid.
 * Use for homepages, landing pages, and other full-width marketing content.
 */
import { ClientRouter } from 'astro:transitions';
import { AppShell, cx, Layout, LayoutContent, mergeProps, ThemeScript } from '@var-ui/astro';
import { docsMarketingPage } from '../styles/docsMarketingPage';
import DocsMobileMenu from './DocsMobileMenu.astro';
import DocsTopBar from './DocsTopBar.astro';
import type { DocsBrand, DocsSearchItem, TopNavItem as TopNavItemType } from '../types';
import { normalizeDocsPath } from '../utils/docs-toc';
import { stripAstroBase } from '../utils/routing';

const {
  title = 'Docs',
  themeClassName,
  bodyClassName,
  topNav,
  searchItems = [],
  brand = { heading: 'Docs', href: '/' },
  htmlAttributes = {},
  bleed = false,
} = Astro.props as {
  title?: string;
  themeClassName: string;
  bodyClassName?: string;
  topNav: readonly TopNavItemType[];
  searchItems?: readonly DocsSearchItem[];
  brand?: DocsBrand;
  htmlAttributes?: Record<string, string | undefined>;
  /**
   * Drop the main column's padding so sections can run edge to edge (full-bleed bands,
   * hero backdrops). The page then owns its own gutters.
   * @default false
   */
  bleed?: boolean;
};

const pathname = stripAstroBase(Astro.url.pathname, import.meta.env.BASE_URL);
const currentPath = normalizeDocsPath(pathname);
const hasToolsSlot = Astro.slots.has('tools');
const hasDrawerToolsSlot = Astro.slots.has('drawerTools');
const hasBrandSlot = Astro.slots.has('brand');
const hasThemeScriptSlot = Astro.slots.has('themeScript');
const showMobileNav = topNav.length > 0;

const page = docsMarketingPage({ bleed });
const hasFooterSlot = Astro.slots.has('footer');
---

<html lang="en" class={themeClassName} {...htmlAttributes}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ThemeScript themeClass={themeClassName} />
    {hasThemeScriptSlot ? <slot name="themeScript" /> : null}
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}typestyles.css`} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class={cx('docs-body', bodyClassName)}>
    <AppShell variant="wash" height="fill" contentPadding="none" mobileBreakpoint="md">
      <DocsTopBar
        slot="topNav"
        topNav={topNav}
        searchItems={searchItems}
        brand={brand}
        currentPath={currentPath}
        mobileNav={showMobileNav}
      >
        {hasBrandSlot ? <slot name="brand" slot="brand" /> : null}
        {hasToolsSlot ? <slot name="tools" slot="tools" /> : null}
      </DocsTopBar>

      {
        showMobileNav ? (
          <DocsMobileMenu slot="mobileNav" topNav={topNav} currentPath={currentPath} brand={brand}>
            {hasBrandSlot ? <slot name="brand" slot="brand" /> : null}
            {hasDrawerToolsSlot ? <slot name="drawerTools" slot="tools" /> : null}
          </DocsMobileMenu>
        ) : null
      }

      <Layout height="fill" padding="none" className={cx(page.siteLayout)}>
        <LayoutContent label="Main content">
          <main {...mergeProps(page.main)}>
            <slot />
          </main>
          {hasFooterSlot ? <slot name="footer" /> : null}
        </LayoutContent>
      </Layout>
    </AppShell>
    <script>
      import '../scripts/docsPageClient.ts';
    </script>
  </body>
</html>
