{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "@var-ui/icons/glyphs": ["../icons/src/glyphs.ts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.astro", "src/env.d.ts"]
}
