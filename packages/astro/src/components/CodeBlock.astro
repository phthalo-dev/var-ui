---
import type { HTMLAttributes } from 'astro/types';
import { codeBlock } from '@var-ui/core/components/codeBlock';
import { codeBlockMarkup } from '@var-ui/core/components/codeBlockMarkup';
import type { CodeBlockVariantProps } from '@var-ui/core';
import { recipeVars, styleVars } from '@var-ui/core/components/styleVars';
import { svg as copySvg } from '@var-ui/icons/glyphs/copy';
import { mergeProps } from '../utils';

type DiffLineTone = 'added' | 'deleted' | 'hunk';

interface Props extends Omit<HTMLAttributes<'div'>, 'children'>, CodeBlockVariantProps {
  code: string;
  language?: string;
  codeHtml?: string;
  codeClassName?: string;
  lineHtml?: string[];
  filename?: string;
  className?: string;
  /** Show the copy button. @default true */
  copyable?: boolean;
  wrapLongLines?: boolean;
  showLineNumbers?: boolean;
  highlightedLines?: number[];
  /** Scroll cap for the code body — any CSS length. */
  maxHeight?: string;
  /** Copy button's accessible name before a copy. Same prop as `CopyButton`. @default Copy code */
  copyLabel?: string;
  /** Name after a successful copy, also announced to screen readers. @default Copied */
  copiedLabel?: string;
  /** Name after a failed copy, also shown and announced beside the button. @default Copy failed */
  errorLabel?: string;
}

function classifyDiffLine(line: string): DiffLineTone | undefined {
  if (line.startsWith('@@')) return 'hunk';
  if (line.startsWith('+') && !line.startsWith('+++')) return 'added';
  if (line.startsWith('-') && !line.startsWith('---')) return 'deleted';
  return undefined;
}

const {
  code,
  language,
  codeHtml,
  codeClassName: highlightedCodeClassName,
  lineHtml,
  filename,
  className,
  copyable = true,
  variant = 'default',
  wrapLongLines = false,
  showLineNumbers = false,
  highlightedLines = [],
  maxHeight,
  copyLabel = 'Copy code',
  copiedLabel = 'Copied',
  errorLabel = 'Copy failed',
  ...rest
} = Astro.props as Props;

const cb = codeBlock({ variant });
const codeBlockVars = recipeVars(codeBlock);
// Same structure as React and the docs Shiki transformer (#194).
const m = codeBlockMarkup({
  code,
  language,
  filename,
  variant: variant === 'inline' ? 'default' : variant,
  copyable,
  copyLabel,
  copiedLabel,
  errorLabel,
});

const highlightedSet = new Set(highlightedLines);
const lines = code.replace(/\n$/, '').split('\n');
const terminal = variant === 'terminal';
const inline = variant === 'inline';
const diff = variant === 'diff';
const useHighlightedHtml = Boolean(codeHtml || lineHtml) && !terminal;
---

{
  inline ? (
    <code {...rest} {...mergeProps(cb.root, cb.code.className, className)}>
      {code}
    </code>
  ) : (
    <div {...rest} {...m.root} class={[m.root.class, className].filter(Boolean).join(' ')}>
      <div {...m.header}>
        <div {...m.title}>
          {m.filename ? <span {...m.filename.attributes}>{m.filename.text}</span> : null}
          {m.language ? <span {...m.language.attributes}>{m.language.text}</span> : null}
        </div>
        {m.actions && m.copyButton && m.feedback ? (
          <div {...m.actions}>
            <button {...m.copyButton}>
              <span {...m.copyIcon} set:html={copySvg} />
            </button>
            <span {...m.feedback} />
          </div>
        ) : null}
      </div>

      <div {...m.body} style={styleVars([[codeBlockVars.maxHeight, maxHeight]])}>
        <pre {...m.pre} data-wrap={wrapLongLines || undefined}
        >{showLineNumbers ? (
            <code {...mergeProps(cb.code)} data-line-numbers={showLineNumbers || undefined}>
              {lines.map((line, index) => {
                const lineNumber = index + 1;
                const lineContentHtml = lineHtml?.[index];
                return (
                  <span
                    {...mergeProps(cb.line)}
                    data-highlighted={highlightedSet.has(lineNumber) || undefined}
                    data-line-tone={diff ? classifyDiffLine(line) : undefined}
                  >
                    <span {...mergeProps(cb.lineNumber)} aria-hidden="true">
                      {lineNumber}
                    </span>
                    {lineContentHtml ? (
                      <span
                        {...mergeProps(cb.lineContent)}
                        set:html={lineContentHtml}
                      />
                    ) : (
                      <span {...mergeProps(cb.lineContent)}>{line || ' '}</span>
                    )}
                  </span>
                );
              })}
            </code>
          ) : diff ? (
            <code {...mergeProps(cb.code)}>
              {lines.map((line) => (
                <span {...mergeProps(cb.line)} data-line-tone={classifyDiffLine(line)}>
                  <span {...mergeProps(cb.lineContent)}>{line || ' '}</span>
                </span>
              ))}
            </code>
          ) : useHighlightedHtml ? (
            <code {...mergeProps(cb.code, highlightedCodeClassName)} set:html={codeHtml} />
          ) : (
            <code {...mergeProps(cb.code)}>{code}</code>
          )}</pre>
      </div>
    </div>
  )
}

{
  !inline && copyable ? (
    <script>
      import { initCodeBlockCopy } from '../scripts/codeBlockCopy';
      initCodeBlockCopy();
    </script>
  ) : null
}
