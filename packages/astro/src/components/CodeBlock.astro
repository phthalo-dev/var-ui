---
import type { HTMLAttributes } from 'astro/types';
import { codeBlock } from '@var-ui/core/components/codeBlock';
import type { CodeBlockVariantProps } from '@var-ui/core';
import { svg as copySvg } from '@var-ui/icons/glyphs/copy';
import { mergeProps } from '../utils';

interface Props extends Omit<HTMLAttributes<'div'>, 'children'>, CodeBlockVariantProps {
  code: string;
  language?: string;
  codeHtml?: string;
  codeClassName?: string;
  lineHtml?: string[];
  filename?: string;
  className?: string;
  /** Show the copy button. @default true */
  copyable?: boolean;
  wrapLongLines?: boolean;
  showLineNumbers?: boolean;
  highlightedLines?: number[];
  copyLabel?: string;
  copiedLabel?: string;
  copyErrorLabel?: string;
}

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

const {
  code,
  language,
  codeHtml,
  codeClassName: highlightedCodeClassName,
  lineHtml,
  filename,
  className,
  copyable = true,
  variant = 'default',
  wrapLongLines = false,
  showLineNumbers = false,
  highlightedLines = [],
  copyLabel = 'Copy code',
  copiedLabel = 'Copied',
  copyErrorLabel = 'Copy failed',
  ...rest
} = Astro.props as Props;

const cb = codeBlock({ variant });

const highlightedSet = new Set(highlightedLines);
const lines = code.replace(/\n$/, '').split('\n');
const terminal = variant === 'terminal';
const inline = variant === 'inline';
const useHighlightedHtml = Boolean(codeHtml || lineHtml) && !terminal;
---

{
  inline ? (
    <code {...rest} {...mergeProps(cb.root, cb.code.className, className)} data-codeblock>
      {code}
    </code>
  ) : (
    <div {...rest} {...mergeProps(cb.root, className)} data-codeblock>
      <div {...mergeProps(cb.header)} data-codeblock-header>
        <div {...mergeProps(cb.title)}>
          {filename ? <span {...mergeProps(cb.filename)}>{filename}</span> : null}
          {language ? <span {...mergeProps(cb.language)}>{language}</span> : null}
        </div>
        {copyable ? (
          <div {...mergeProps(cb.actions)}>
            <button
              type="button"
              {...mergeProps(cb.copyButton)}
              data-var-ui-code-copy
              data-code={code}
              data-copy-label={copyLabel}
              data-copied-label={copiedLabel}
              data-copy-error-label={copyErrorLabel}
              aria-label={copyLabel}
            >
              <span data-codeblock-copy-icon set:html={copySvg} />
              <span data-codeblock-copy-text>Copy</span>
            </button>
            <span
              {...mergeProps(cb.feedback)}
              data-codeblock-feedback
              role="status"
              aria-live="polite"
            />
          </div>
        ) : null}
      </div>

      <div {...mergeProps(cb.body)} data-codeblock-body>
        <pre {...mergeProps(cb.pre)} data-wrap={wrapLongLines || undefined} data-codeblock-pre
        >{showLineNumbers ? (
            <code {...mergeProps(cb.code)} data-line-numbers={showLineNumbers || undefined}>
              {lines.map((line, index) => {
                const lineNumber = index + 1;
                const lineContentHtml = lineHtml?.[index];
                return (
                  <span
                    {...mergeProps(cb.line)}
                    data-highlighted={highlightedSet.has(lineNumber) || undefined}
                  >
                    <span {...mergeProps(cb.lineNumber)} aria-hidden="true">
                      {lineNumber}
                    </span>
                    {lineContentHtml ? (
                      <span
                        {...mergeProps(cb.lineContent)}
                        set:html={lineContentHtml}
                      />
                    ) : (
                      <span {...mergeProps(cb.lineContent)}>{line || ' '}</span>
                    )}
                  </span>
                );
              })}
            </code>
          ) : useHighlightedHtml ? (
            <code {...mergeProps(cb.code, highlightedCodeClassName)} set:html={codeHtml} />
          ) : (
            <code {...mergeProps(cb.code)}>{escapeHtml(code)}</code>
          )}</pre>
      </div>
    </div>
  )
}

{
  !inline && copyable ? (
    <script>
      import { initCodeBlockCopy } from '../scripts/codeBlockCopy';
      initCodeBlockCopy();
    </script>
  ) : null
}
