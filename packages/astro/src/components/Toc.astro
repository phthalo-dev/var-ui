---
import { toc } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  title?: string;
  label?: string;
  auto?: boolean;
  contentSelector?: string;
  headingSelector?: string;
  minHeadings?: number;
  headerOffset?: number;
  hideBelowXl?: boolean;
  stickyTop?: string;
  className?: string;
};

const {
  title = 'On this page',
  label,
  auto = false,
  contentSelector,
  headingSelector,
  minHeadings = 2,
  headerOffset,
  hideBelowXl = false,
  stickyTop,
  className,
} = Astro.props;

const resolvedLabel = label ?? title;
// The recipe always hides the rail below `xl`; `hideBelowXl` predates that and has no
// selection of its own, so the recipe is called without arguments.
const s = toc();
const rootStyle = stickyTop ? `--var-ui-toc-sticky-top: ${stickyTop}` : undefined;
---

<nav
  {...mergeProps(s.root, className)}
  style={rootStyle}
  aria-label={resolvedLabel}
  data-var-ui-toc
  data-auto={auto || undefined}
  data-content-selector={auto ? contentSelector : undefined}
  data-heading-selector={auto && headingSelector ? headingSelector : undefined}
  data-min-headings={auto ? String(minHeadings) : undefined}
  data-header-offset={auto && headerOffset != null ? String(headerOffset) : undefined}
  hidden={auto || undefined}
>
  {title ? <p {...mergeProps(s.title)}>{title}</p> : null}
  <ol {...mergeProps(s.list)} data-var-ui-toc-list>
    {!auto ? <slot /> : null}
  </ol>
</nav>

<script>
  import { initTocs } from '../scripts/toc';

  function onPageLoad(): void {
    initTocs();
  }

  onPageLoad();
  document.addEventListener('astro:page-load', onPageLoad);
</script>
