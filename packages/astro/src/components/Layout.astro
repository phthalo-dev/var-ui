---
import { layout } from '@var-ui/core/components/layout';
import { layoutShellPaddingAssignments, layoutContentWidthAssignment } from '@var-ui/core/components/layoutShellVars';
import type { LayoutPadding, LayoutVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  height?: NonNullable<LayoutVariantProps['height']>;
  /** Sets shell CSS vars on the root. Omit for recipe default (`space[4]`). */
  padding?: LayoutPadding;
  /** Constrains header/footer inner wrappers via shell CSS vars. */
  contentWidth?: number;
  className?: string;
};

const { height = 'fill', padding, contentWidth, className } = Astro.props;
const l = layout({ height });
const rootStyle = {
  ...(padding != null ? layoutShellPaddingAssignments(padding) : {}),
  ...(contentWidth != null ? layoutContentWidthAssignment(contentWidth) : {}),
};
const hasRootStyle = Object.keys(rootStyle).length > 0;

const hasHeader = Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');
const hasStart = Astro.slots.has('start');
const hasEnd = Astro.slots.has('end');
---

<div
  {...mergeProps(l.root, className)}
  style={hasRootStyle ? rootStyle : undefined}
  data-has-header={hasHeader ? '' : undefined}
  data-has-footer={hasFooter ? '' : undefined}
  data-has-start={hasStart ? '' : undefined}
  data-has-end={hasEnd ? '' : undefined}
>
  <div {...mergeProps(l.outer)}>
    <div {...mergeProps(l.inner)}>
      {hasHeader && <slot name="header" />}
      <div {...mergeProps(l.middle)}>
        {hasStart && <slot name="start" />}
        <slot />
        {hasEnd && <slot name="end" />}
      </div>
      {hasFooter && <slot name="footer" />}
    </div>
  </div>
</div>
