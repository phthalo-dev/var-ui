---
import type { HTMLAttributes } from 'astro/types';
import { card } from '@var-ui/core/components/card';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'div'>, 'title'> & {
  title?: string;
  /** Semantic level of the title heading. @default 3 */
  headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
  className?: string;
};

const { title, headingLevel = 3, className, ...rest } = Astro.props;
const Heading = `h${headingLevel}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const c = card();
---
<div {...rest} {...mergeProps(c.root, className)}>
  {title ? <Heading {...mergeProps(c.title)}>{title}</Heading> : null}
  <div {...mergeProps(c.body)}><slot /></div>
</div>
