---
import { card } from '@var-ui/core/components/card';
import { mergeProps } from '../utils';

type Props = {
  title?: string;
  className?: string;
};

const { title, className } = Astro.props;
const c = card();
---
<div {...mergeProps(c.root, className)}>
  {title ? <h3 {...mergeProps(c.title)}>{title}</h3> : null}
  <div {...mergeProps(c.body)}><slot /></div>
</div>
