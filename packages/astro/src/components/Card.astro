---
import type { HTMLAttributes } from 'astro/types';
import { card } from '@var-ui/core/components/card';
import { combine, mergeProps } from '../utils';

type DivProps = Omit<HTMLAttributes<'div'>, 'title'> & {
  href?: undefined;
  /** Optional heading rendered above the body. */
  title?: string;
  /** Semantic level of the title heading. @default 3 */
  headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
  /** Supporting copy below the title. */
  description?: string;
  className?: string;
};

/**
 * With `href` the whole card is a link, like React's `Card` and `Button`. A `media` slot renders
 * full-bleed above the title (React: the `media` prop), and a `title-end` slot sits at the end of
 * the title row, e.g. a status badge (React: `titleEnd`).
 */
type LinkProps = Omit<HTMLAttributes<'a'>, 'title' | 'href'> & {
  href: string;
  /** Card headline. */
  title: string;
  /** Supporting copy below the title. */
  description?: string;
  /** Trailing hint line (e.g. reading time, "Learn more →"). */
  hint?: string;
  className?: string;
};

type Props = DivProps | LinkProps;

// One destructure for both shapes; `href` decides which element renders.
const {
  href,
  title,
  description,
  hint,
  headingLevel = 3,
  className,
  ...rest
} = Astro.props as Omit<DivProps, 'href'> & Partial<Omit<LinkProps, 'href'>> & { href?: string };
const c = card();
const Heading = `h${headingLevel}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const hasTitleEnd = Astro.slots.has('title-end');
const hasBody = Astro.slots.has('default');
---
{href !== undefined ? (
  <a href={href} {...rest} {...combine(c.root, c.linkRoot, className)}>
    {Astro.slots.has('media') ? <div {...mergeProps(c.media)}><slot name="media" /></div> : null}
    {hasTitleEnd ? (
      <span {...mergeProps(c.header)}>
        <span {...mergeProps(c.linkTitle)}>{title}</span>
        <span {...mergeProps(c.titleEnd)}><slot name="title-end" /></span>
      </span>
    ) : (
      <span {...mergeProps(c.linkTitle)}>{title}</span>
    )}
    {description ? <p {...mergeProps(c.linkDescription)}>{description}</p> : null}
    <slot />
    {hint ? <span {...mergeProps(c.linkHint)}>{hint}</span> : null}
  </a>
) : (
  <div {...rest} {...mergeProps(c.root, className)}>
    {hasTitleEnd ? (
      <div {...mergeProps(c.header)}>
        {title ? <Heading {...mergeProps(c.title)}>{title}</Heading> : null}
        <div {...mergeProps(c.titleEnd)}><slot name="title-end" /></div>
      </div>
    ) : title ? (
      <Heading {...mergeProps(c.title)}>{title}</Heading>
    ) : null}
    {description ? <p {...mergeProps(c.description)}>{description}</p> : null}
    {hasBody ? <div {...mergeProps(c.body)}><slot /></div> : null}
  </div>
)}
