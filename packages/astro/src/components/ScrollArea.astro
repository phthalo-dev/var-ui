---
import type { VariantOptions } from 'typestyles';
import {
  resolveScrollAreaFade,
  scrollArea,
  scrollAreaFade,
  scrollAreaFadeEdgesFor,
  scrollAreaOrientation,
} from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  /** @default 'vertical' */
  orientation?: VariantOptions<typeof scrollAreaOrientation>;
  /** Edge fade masks. @default false */
  fade?: boolean | VariantOptions<typeof scrollAreaFade>;
  className?: string;
  viewportClassName?: string;
};

const {
  orientation = scrollAreaOrientation.default,
  fade = false,
  className,
  viewportClassName,
} = Astro.props;
const fadeMode = resolveScrollAreaFade(fade, orientation);
const s = scrollArea({ fade: fadeMode, orientation });
const edges = scrollAreaFadeEdgesFor(fadeMode);
---

<div {...mergeProps(s.root, className)}>
  <div {...mergeProps(s.viewport, viewportClassName)}>
    {
      edges.block ? (
        <div aria-hidden="true" {...mergeProps(s.fadeTop)} data-edge="block-start" />
      ) : null
    }
    {
      edges.inline ? (
        <div aria-hidden="true" {...mergeProps(s.fadeStart)} data-edge="inline-start" />
      ) : null
    }
    <slot />
    {
      edges.inline ? (
        <div aria-hidden="true" {...mergeProps(s.fadeEnd)} data-edge="inline-end" />
      ) : null
    }
    {
      edges.block ? (
        <div aria-hidden="true" {...mergeProps(s.fadeBottom)} data-edge="block-end" />
      ) : null
    }
  </div>
</div>
