---
import { resolveScrollAreaFade, scrollArea, type ScrollAreaVariantProps, } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  orientation?: NonNullable<ScrollAreaVariantProps['orientation']>;
  fade?: boolean | NonNullable<ScrollAreaVariantProps['fade']>;
  className?: string;
  viewportClassName?: string;
};

const { orientation = 'vertical', fade = false, className, viewportClassName } = Astro.props;
const fadeMode = resolveScrollAreaFade(fade, orientation);
const s = scrollArea({ fade: fadeMode, orientation });
const showVerticalFade = fadeMode === 'vertical' || fadeMode === 'both';
const showHorizontalFade = fadeMode === 'horizontal' || fadeMode === 'both';
---

<div {...mergeProps(s.root, className)}>
  <div {...mergeProps(s.viewport, viewportClassName)}>
    {
      showVerticalFade ? (
        <div aria-hidden="true" {...mergeProps(s.fadeTop)} data-edge="block-start" />
      ) : null
    }
    {
      showHorizontalFade ? (
        <div aria-hidden="true" {...mergeProps(s.fadeStart)} data-edge="inline-start" />
      ) : null
      }
    <slot />
    {
      showHorizontalFade ? (
        <div aria-hidden="true" {...mergeProps(s.fadeEnd)} data-edge="inline-end" />
      ) : null
    }
    {
      showVerticalFade ? (
        <div aria-hidden="true" {...mergeProps(s.fadeBottom)} data-edge="block-end" />
      ) : null
    }
  </div>
</div>
