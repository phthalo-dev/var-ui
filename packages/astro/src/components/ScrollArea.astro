---
import type { HTMLAttributes } from 'astro/types';
import type { VariantOptions } from 'typestyles';
import { resolveScrollAreaFade, scrollArea, scrollAreaFade, scrollAreaFadeEdgesFor, scrollAreaOrientation } from '@var-ui/core/components/scrollArea';
import { mergeProps } from '../utils';

type Props = HTMLAttributes<'div'> & {
  /** @default 'vertical' */
  orientation?: VariantOptions<typeof scrollAreaOrientation>;
  /** Edge fade masks. @default false */
  fade?: boolean | VariantOptions<typeof scrollAreaFade>;
  className?: string;
  viewportClassName?: string;
};

const {
  orientation = scrollAreaOrientation.default,
  fade = false,
  className,
  viewportClassName,
  ...rest
} = Astro.props;
const fadeMode = resolveScrollAreaFade(fade, orientation);
const s = scrollArea({ fade: fadeMode, orientation });
const edges = scrollAreaFadeEdgesFor(fadeMode);
---

<div {...rest} {...mergeProps(s.root, className)}>
  <div {...mergeProps(s.viewport, viewportClassName)}>
    {
      edges.block ? (
        <div aria-hidden="true" {...mergeProps(s.fadeTop)} />
      ) : null
    }
    {
      edges.inline ? (
        <div aria-hidden="true" {...mergeProps(s.fadeStart)} />
      ) : null
    }
    <slot />
    {
      edges.inline ? (
        <div aria-hidden="true" {...mergeProps(s.fadeEnd)} />
      ) : null
    }
    {
      edges.block ? (
        <div aria-hidden="true" {...mergeProps(s.fadeBottom)} />
      ) : null
    }
  </div>
</div>
