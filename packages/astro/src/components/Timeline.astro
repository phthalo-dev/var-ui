---
import { timeline } from '@var-ui/core/components/timeline';
import type { TimelineVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

interface Props extends TimelineVariantProps {
  className?: string;
}

const { size = 'md', tone = 'accent', className } = Astro.props;
const styles = timeline({ size, tone });
---

<ol {...mergeProps(styles.root, className)} data-timeline>
  <slot />
</ol>
