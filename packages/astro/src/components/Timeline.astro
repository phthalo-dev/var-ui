---
import type { HTMLAttributes } from 'astro/types';
import { timeline } from '@var-ui/core/components/timeline';
import type { TimelineVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

interface Props extends HTMLAttributes<'ol'>, TimelineVariantProps {
  className?: string;
}

const { size = 'md', tone = 'accent', className, ...rest } = Astro.props;
const styles = timeline({ size, tone });
---

<ol {...rest} {...mergeProps(styles.root, className)} data-timeline>
  <slot />
</ol>
