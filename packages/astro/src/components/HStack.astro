---
import type { HTMLAttributes } from 'astro/types';
import { stack } from '@var-ui/core/components/stack';
import type { Gap, StackVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = HTMLAttributes<'div'> & {
  gap?: Gap;
  align?: NonNullable<StackVariantProps['align']>;
  justify?: NonNullable<StackVariantProps['justify']>;
  wrap?: boolean;
  /** HTML element to render — `span` works inside buttons and links. @default div */
  as?: 'div' | 'span';
  className?: string;
};

const {
  gap = 'sm',
  align = 'center',
  justify = 'start',
  wrap = false,
  as = 'div',
  className,
  ...rest
} = Astro.props;
const rp = mergeProps(
  stack({ direction: 'row', gap, align, justify, wrap: wrap ? 'wrap' : 'nowrap' }),
  className,
);
const StackTag = as;
---
<StackTag {...rest} {...rp}><slot /></StackTag>
