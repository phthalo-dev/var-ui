---
import { button, type ButtonVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

interface Props extends ButtonVariantProps {
  className?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const {
  tone,
  appearance,
  size = 'md',
  layout,
  elevated,
  className,
  type = 'button',
  disabled,
} = Astro.props;
const rp = mergeProps(button({ tone, appearance, size, layout, elevated }), className);
---

<button type={type} disabled={disabled} {...rp}><slot /></button>
