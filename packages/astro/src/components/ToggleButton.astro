---
import { toggleButton } from '@var-ui/core/components/toggleButton';
import type { ControlSize } from '@var-ui/core';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from "../utils";

type Props = Omit<HTMLAttributes<'button'>, 'class:list'> & {
  /** Initially selected (`aria-pressed`); the button toggles on click. Same name as React's uncontrolled `defaultSelected`. @default false */
  defaultSelected?: boolean;
  size?: ControlSize;
  className?: string;
};

const {
  defaultSelected = false,
  size = "md",
  className,
  ...rest
} = Astro.props;
---

<button
  type="button"
  {...rest}
  data-var-ui-toggle-button
  aria-pressed={defaultSelected ? "true" : "false"}
  data-selected={defaultSelected ? "" : undefined}
  {...mergeProps(toggleButton({ size }), className)}
>
  <slot />
</button>

<script>
  import { initToggleButtons } from "../scripts/toggleButton";
  initToggleButtons();
</script>
