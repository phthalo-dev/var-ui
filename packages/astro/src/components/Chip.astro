---
import type { HTMLAttributes } from 'astro/types';
import { chip } from '@var-ui/core/components/chip';
import type { ChipVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

interface Props extends HTMLAttributes<'span'>, ChipVariantProps {
  className?: string;
}

const { tone = 'neutral', appearance = 'subtle', className, ...rest } = Astro.props;
const c = chip({ tone, appearance });
---

<span {...rest} {...mergeProps(c.root, className)}>
  <span {...mergeProps(c.label)}><slot /></span>
</span>
