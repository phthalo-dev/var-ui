---
import type { HTMLAttributes } from 'astro/types';
import { layoutPanel, LAYOUT_PANEL_POPUP_ATTRIBUTE } from '@var-ui/core/components/layout';
import type { LayoutPadding, LayoutPanelVariantProps } from '@var-ui/core';
import type { LayoutBreakpoint } from '@var-ui/core/components/breakpoints';
import { mergeProps } from '../utils';
import { mergeInlineStyle } from '../lib/mergeInlineStyle';

type Props = Omit<HTMLAttributes<'div'>, 'class:list'> & {
  width?: number | string;
  hasDivider?: boolean;
  /** Let the zone scroll its overflow (`overflow: auto`). @default true */
  scrollable?: boolean;
  padding?: LayoutPadding;
  side?: 'start' | 'end';
  label?: string;
  /**
   * Collapses the panel below a breakpoint, same shape as React. `overlay` moves it into a native
   * modal `<dialog>` drawer when opened; `hidden` shows it in place when opened. CSS hides it on
   * the first paint. Open it with a button carrying `data-var-ui-layout-panel-toggle` and
   * `aria-controls` set to the panel `id`, or with `setLayoutPanelOpen(panel, true)`.
   */
  responsive?: { below: LayoutBreakpoint; mode: 'overlay' | 'hidden' };
  /** Starts open below the breakpoint (`responsive` only). @default false */
  defaultOpen?: boolean;
  className?: string;
};

/** `layoutPanel()` only supports seamless (`inherit`, the default) or `0`. */
function toZonePaddingVariant(
  padding: LayoutPadding | undefined,
): NonNullable<LayoutPanelVariantProps['padding']> {
  return padding === 'none' ? 'none' : 'inherit';
}

function toCssSize(value: number | string | undefined): string | undefined {
  if (value == null) return undefined;
  return typeof value === 'number' ? `${value}px` : value;
}

const {
  width,
  hasDivider = false,
  scrollable = true,
  padding,
  side,
  role,
  label,
  responsive,
  defaultOpen = false,
  className,
  style: styleProp,
  ...rest
} = Astro.props;
const s = layoutPanel({ scrollable, hasDivider, padding: toZonePaddingVariant(padding) });
const resolvedRole = role ?? (label != null ? 'region' : undefined);
const widthValue = toCssSize(width);
const style = mergeInlineStyle(widthValue != null ? { width: widthValue } : undefined, styleProp);
const popupAttrs = { [LAYOUT_PANEL_POPUP_ATTRIBUTE]: '' };
---

<div
  aria-label={label}
  {...rest}
  {...mergeProps(s.panel, className)}
  data-side={side}
  data-var-ui-layout-panel={responsive ? '' : undefined}
  data-responsive={responsive?.mode}
  data-responsive-below={responsive?.below}
  data-open={responsive && defaultOpen ? '' : undefined}
  style={style}
  role={resolvedRole}
>
  <slot />
</div>
{
  responsive?.mode === 'overlay' && (
    <dialog
      {...popupAttrs}
      {...mergeProps(s.popup)}
      data-side={side}
      aria-label={label ?? 'Panel'}
    >
      <div {...mergeProps(s.body)} />
    </dialog>
  )
}

<script>
  // Bundled once per page; does nothing unless a panel has `responsive`.
  import { initLayoutPanels } from '../scripts/layoutPanel';
  initLayoutPanels();
  document.addEventListener('astro:page-load', initLayoutPanels);
</script>
