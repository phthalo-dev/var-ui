---
import type { HTMLAttributes } from 'astro/types';
import { layoutPanel } from '@var-ui/core/components/layout';
import type { LayoutPadding, LayoutPanelVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';
import { mergeInlineStyle } from '../lib/mergeInlineStyle';

type Props = Omit<HTMLAttributes<'div'>, 'class:list'> & {
  width?: number | string;
  hasDivider?: boolean;
  scrollable?: boolean;
  padding?: LayoutPadding;
  side?: 'start' | 'end';
  label?: string;
  className?: string;
};

/** `layoutPanel()` only supports seamless (`inherit`, the default) or `0`. */
function toZonePaddingVariant(
  padding: LayoutPadding | undefined,
): NonNullable<LayoutPanelVariantProps['padding']> {
  return padding === 0 ? '0' : 'inherit';
}

function toCssSize(value: number | string | undefined): string | undefined {
  if (value == null) return undefined;
  return typeof value === 'number' ? `${value}px` : value;
}

const {
  width,
  hasDivider = false,
  scrollable = true,
  padding,
  side,
  role,
  label,
  className,
  style: styleProp,
  ...rest
} = Astro.props;
const s = layoutPanel({ scrollable, hasDivider, padding: toZonePaddingVariant(padding) });
const resolvedRole = role ?? (label != null ? 'region' : undefined);
const widthValue = toCssSize(width);
const style = mergeInlineStyle(widthValue != null ? { width: widthValue } : undefined, styleProp);
---

<div
  aria-label={label}
  {...rest}
  {...mergeProps(s.panel, className)}
  data-side={side}
  style={style}
  role={resolvedRole}
>
  <slot />
</div>
