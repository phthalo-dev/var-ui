---
import { icon, mobileNav } from '@var-ui/core';
import { svg as menuSvg } from '@var-ui/icons/glyphs/menu';
import { mergeProps } from '../utils';

type Props = {
  label?: string;
  className?: string;
};

const { label = 'Open navigation', className } = Astro.props;
const s = mobileNav();
const hasIcon = Astro.slots.has('default');
const iconRecipe = mergeProps(icon({ size: 'md' }));
---

<button
  type="button"
  data-var-ui-mobile-nav-toggle
  aria-label={label}
  aria-expanded="false"
  {...mergeProps(s.toggle, className)}
>
  {hasIcon ? <slot /> : <span {...iconRecipe} set:html={menuSvg} />}
</button>

<script>
  import { initMobileNavToggles } from '../scripts/mobileNav';
  initMobileNavToggles();
</script>
