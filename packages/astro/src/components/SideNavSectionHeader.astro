---
import { sideNav } from '@var-ui/core/components/sideNav';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'div'>, 'class:list' | 'title'> & {
  title: string;
  className?: string;
};

const { title, className, ...rest } = Astro.props;
const s = sideNav();
---

<div {...rest} {...mergeProps(s.sectionTitle, className)}>{title}</div>
