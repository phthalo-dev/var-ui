---
import type { HTMLAttributes } from 'astro/types';
import { steps } from '@var-ui/core/components/steps';
import { mergeProps } from '../utils';

type Props = HTMLAttributes<'ol'> & {
  className?: string;
};

const { className, ...rest } = Astro.props;
---

<ol {...rest} {...mergeProps(steps().root, className)}>
  <slot />
</ol>
