---
import type { HTMLAttributes } from 'astro/types';
import { kbd } from '@var-ui/core/components/kbd';
import { mergeProps } from '../utils';

type Props = HTMLAttributes<'kbd'> & {
  className?: string;
};

const { className, ...rest } = Astro.props;
const rp = mergeProps(kbd(), className);
---
<kbd {...rest} {...rp}><slot /></kbd>
