---
import type { HTMLAttributes } from 'astro/types';
import { progressBar } from '@var-ui/core/components/progressBar';
import type { ProgressBarVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'div'>, 'children'> &
  ProgressBarVariantProps & {
  value?: number;
  minValue?: number;
  maxValue?: number;
  indeterminate?: boolean;
  label?: string;
  showValueText?: boolean;
  className?: string;
};

const {
  value = 0,
  minValue = 0,
  maxValue = 100,
  indeterminate = false,
  label,
  tone = 'accent',
  appearance = 'solid',
  showValueText = true,
  className,
  ...rest
} = Astro.props;

const p = progressBar({
  tone,
  appearance,
  indeterminate,
});
const showValue = showValueText && !indeterminate;
const percentage =
  maxValue === minValue ? 0 : ((value - minValue) / (maxValue - minValue)) * 100;
const valueText = `${Math.round(percentage)}%`;
const showHeader = Boolean(label) || showValue;
---
<div
  {...rest}
  {...mergeProps(p.root, className)}
  role="progressbar"
  aria-label={label}
  aria-valuemin={indeterminate ? undefined : minValue}
  aria-valuemax={indeterminate ? undefined : maxValue}
  aria-valuenow={indeterminate ? undefined : value}
>
  {
    showHeader ? (
      <div {...mergeProps(p.header)}>
        {label ? <span {...mergeProps(p.label)}>{label}</span> : <span />}
        {showValue ? <span {...mergeProps(p.valueText)}>{valueText}</span> : null}
      </div>
    ) : null
  }
  <div {...mergeProps(p.track)}>
    <div
      {...mergeProps(p.fill)}
      style={indeterminate ? undefined : { width: `${percentage}%` }}
    />
  </div>
</div>
