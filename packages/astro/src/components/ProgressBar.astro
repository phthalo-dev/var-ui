---
import type { HTMLAttributes } from 'astro/types';
import { progressBar } from '@var-ui/core/components/progressBar';
import type { ProgressBarVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'div'>, 'children'> &
  ProgressBarVariantProps & {
  value?: number;
  /** @default 0 */
  min?: number;
  /** @default 100 */
  max?: number;
  indeterminate?: boolean;
  /** Label above the track; also the accessible name (else pass `aria-label`). */
  label?: string;
  /** Show the formatted value beside the label. @default true when `label` is set */
  showValueText?: boolean;
  /** Spoken and displayed value, replacing the formatted percentage. */
  valueLabel?: string;
  className?: string;
};

const {
  value = 0,
  min = 0,
  max = 100,
  indeterminate = false,
  label,
  size = 'md',
  tone = 'accent',
  appearance = 'solid',
  showValueText = Boolean(label),
  valueLabel,
  className,
  ...rest
} = Astro.props;

const p = progressBar({
  size,
  tone,
  appearance,
  indeterminate,
});
const showValue = showValueText && !indeterminate;
const percentage = max === min ? 0 : ((Math.min(max, Math.max(min, value)) - min) / (max - min)) * 100;
const valueText = valueLabel ?? `${Math.round(percentage)}%`;
const showHeader = Boolean(label) || showValue;
---
<div
  {...rest}
  {...mergeProps(p.root, className)}
  role="progressbar"
  aria-label={label}
  aria-valuemin={indeterminate ? undefined : min}
  aria-valuemax={indeterminate ? undefined : max}
  aria-valuenow={indeterminate ? undefined : value}
  aria-valuetext={indeterminate ? undefined : valueText}
>
  {
    showHeader ? (
      <div {...mergeProps(p.header)}>
        {label ? <span {...mergeProps(p.label)}>{label}</span> : <span />}
        {showValue ? <span {...mergeProps(p.valueText)}>{valueText}</span> : null}
      </div>
    ) : null
  }
  <div {...mergeProps(p.track)}>
    <div
      {...mergeProps(p.fill)}
      style={indeterminate ? undefined : { width: `${percentage}%` }}
    />
  </div>
</div>
