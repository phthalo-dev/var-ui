---
import { sideNav } from '@var-ui/core/components/sideNav';
import { mergeProps } from '../utils';

type Props = {
  heading: string;
  headingHref?: string;
  superheading?: string;
  subheading?: string;
  className?: string;
};

const { heading, headingHref, superheading, subheading, className } = Astro.props;
const s = sideNav();
---

<div {...mergeProps(s.headingBar, className)}>
  {
    headingHref ? (
      <a href={headingHref} {...mergeProps(s.headingBrand)}>
        <slot name="icon" />
        <span {...mergeProps(s.headingBrandText)}>
          {superheading != null ? <span {...mergeProps(s.headingBrandMeta)}>{superheading}</span> : null}
          <span {...mergeProps(s.headingBrandTitle)}>{heading}</span>
          {subheading != null ? <span {...mergeProps(s.headingBrandMeta)}>{subheading}</span> : null}
        </span>
      </a>
    ) : (
      <span {...mergeProps(s.headingBrand)}>
        <slot name="icon" />
        <span {...mergeProps(s.headingBrandText)}>
          {superheading != null ? <span {...mergeProps(s.headingBrandMeta)}>{superheading}</span> : null}
          <span {...mergeProps(s.headingBrandTitle)}>{heading}</span>
          {subheading != null ? <span {...mergeProps(s.headingBrandMeta)}>{subheading}</span> : null}
        </span>
      </span>
    )
  }
  {Astro.slots.has('menu') ? <slot name="menu" /> : null}
</div>
