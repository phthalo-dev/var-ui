---
import type { HTMLAttributes } from 'astro/types';
import { collapsible } from '@var-ui/core/components/collapsible';
import type { CollapsibleVariantProps } from '@var-ui/core';
import { svg as chevronDownSvg } from '@var-ui/icons/glyphs/chevronDown';
import { mergeProps } from '../utils';

interface Props extends Omit<HTMLAttributes<'details'>, 'id' | 'title'>, CollapsibleVariantProps {
  /** Stable id for the panel. */
  id: string;
  /** Default trigger label when `AccordionTrigger` is omitted. */
  title?: string;
  defaultExpanded?: boolean;
  className?: string;
}

const {
  id,
  title,
  defaultExpanded = false,
  variant = 'accordion',
  className,
  ...rest
} = Astro.props;

const c = collapsible({ variant });
const hasTriggerSlot = Astro.slots.has('trigger');
---

<details
  {...rest}
  data-var-ui-accordion-item
  data-accordion-id={id}
  id={id}
  open={defaultExpanded || undefined}
  {...mergeProps(c.root, className)}
>
  <summary {...mergeProps(c.trigger)} data-var-ui-accordion-trigger>
    {
      hasTriggerSlot ? (
        <slot name="trigger" />
      ) : (
        <>
          <span {...mergeProps(c.triggerIcon)} set:html={chevronDownSvg} />
          {title}
        </>
      )
    }
  </summary>
  {
    Astro.slots.has('panel') ? (
      <slot name="panel" />
    ) : (
      <div {...mergeProps(c.panel)}>
        <slot />
      </div>
    )
  }
</details>
