---
import { grid } from '@var-ui/core/components/grid';
import type { GridVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  columns?: 'auto' | 1 | 2 | 3 | 4;
  gap?: NonNullable<GridVariantProps['gap']>;
  className?: string;
};

const columnVariant = {
  auto: 'auto',
  1: 'one',
  2: 'two',
  3: 'three',
  4: 'four',
} as const satisfies Record<
  NonNullable<Props['columns']>,
  NonNullable<GridVariantProps['columns']>
>;

const { columns = 'auto', gap = 'md', className } = Astro.props;
const rp = mergeProps(grid({ columns: columnVariant[columns], gap }), className);
---
<div {...rp}><slot /></div>
