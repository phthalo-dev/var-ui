---
import type { HTMLAttributes } from 'astro/types';
import { topNav } from '@var-ui/core/components/topNav';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'a'>, 'class:list' | 'href'> & {
  heading: string;
  headingHref?: string;
  className?: string;
};

const { heading, headingHref, className, ...rest } = Astro.props;
const s = topNav();
const hasCustomContent = Astro.slots.has('default');
---

{
  headingHref ? (
    <a {...rest} href={headingHref} {...mergeProps(s.brand, className)}>
      <slot name="icon" />
      {hasCustomContent ? <slot /> : <span>{heading}</span>}
    </a>
  ) : (
    <span {...(rest as object)} {...mergeProps(s.brand, className)}>
      <slot name="icon" />
      {hasCustomContent ? <slot /> : <span>{heading}</span>}
    </span>
  )
}
