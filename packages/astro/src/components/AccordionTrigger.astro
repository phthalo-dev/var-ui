---
import { collapsible, type CollapsibleVariantProps } from '@var-ui/core';
import { defaultIconSvgs } from '@var-ui/icons/glyphs';
import { mergeProps } from '../utils';

interface Props extends CollapsibleVariantProps {}

const { variant = 'accordion' } = Astro.props;
const c = collapsible({ variant });
---

<span slot="trigger">
  <span {...mergeProps(c.triggerIcon)} set:html={defaultIconSvgs.chevronDown} />
  <slot />
</span>
