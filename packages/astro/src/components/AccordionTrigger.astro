---
import { collapsible } from '@var-ui/core/components/collapsible';
import type { CollapsibleVariantProps } from '@var-ui/core';
import { svg as chevronDownSvg } from '@var-ui/icons/glyphs/chevronDown';
import { mergeProps } from '../utils';

interface Props extends CollapsibleVariantProps {}

const { variant = 'accordion' } = Astro.props;
const c = collapsible({ variant });
---

<span slot="trigger">
  <span {...mergeProps(c.triggerIcon)} set:html={chevronDownSvg} />
  <slot />
</span>
