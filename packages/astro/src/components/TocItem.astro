---
import type { HTMLAttributes } from 'astro/types';
import { toc } from '@var-ui/core/components/toc';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'li'>, 'children'> & {
  label: string;
  href: string;
  selected?: boolean;
  nested?: boolean;
  className?: string;
};

const { label, href, selected = false, nested = false,
  className,
  ...rest
} = Astro.props;
const s = toc();
const itemClass = mergeProps(s.item).className;
const linkClass = mergeProps(s.link, className).className;
---

<li {...rest} class={itemClass} data-nested={nested || undefined}>
  <a
    href={href}
    class={linkClass}
    data-selected={selected ? '' : undefined}
    aria-current={selected ? 'location' : undefined}
  >
    {label}
  </a>
</li>
