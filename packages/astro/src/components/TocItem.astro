---
import type { HTMLAttributes } from 'astro/types';
import { toc } from '@var-ui/core/components/toc';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'li'>, 'children'> & {
  label: string;
  href: string;
  isSelected?: boolean;
  isNested?: boolean;
  className?: string;
};

const { label, href, isSelected = false, isNested = false,
  className,
  ...rest
} = Astro.props;
const s = toc();
const itemClass = mergeProps(s.item).className;
const linkClass = mergeProps(s.link, className).className;
---

<li {...rest} class={itemClass} data-nested={isNested || undefined}>
  <a
    href={href}
    class={linkClass}
    data-selected={isSelected ? '' : undefined}
    aria-current={isSelected ? 'location' : undefined}
  >
    {label}
  </a>
</li>
