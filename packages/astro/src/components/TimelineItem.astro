---
import { timeline, type TimelineVariantProps, type Tone } from '@var-ui/core';
import { mergeProps } from '../utils';

interface Props extends TimelineVariantProps {
  title?: string;
  description?: string;
  timestamp?: string;
  tone?: Tone;
  className?: string;
}

const { title, description, timestamp, tone, size = 'md', className } = Astro.props;
const styles = timeline({ size, tone: tone ?? 'accent' });
---

<li {...mergeProps(styles.item, className)} data-active>
  <div {...mergeProps(styles.bullet)} data-active data-tone={tone ?? 'accent'} aria-hidden="true"></div>
  <div {...mergeProps(styles.body)}>
    {title ? <div {...mergeProps(styles.title)}>{title}</div> : null}
    {timestamp ? <div {...mergeProps(styles.timestamp)}>{timestamp}</div> : null}
    {description ? <div {...mergeProps(styles.description)}>{description}</div> : null}
    <slot />
  </div>
</li>
