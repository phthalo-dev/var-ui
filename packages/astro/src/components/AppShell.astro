---
import { appShell, type AppShellContentPadding, type AppShellMobileBreakpoint, type AppShellVariantProps, } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  height?: NonNullable<AppShellVariantProps['height']>;
  variant?: NonNullable<AppShellVariantProps['variant']>;
  contentPadding?: AppShellContentPadding;
  mobileBreakpoint?: AppShellMobileBreakpoint;
  disabled?: boolean;
  layout?: 'default' | 'alt';
  sideNavCollapsed?: boolean;
  asideCollapsed?: boolean;
  headerHidden?: boolean;
  headerOffset?: boolean;
  className?: string;
};

const {
  height = 'fill',
  variant = 'elevated',
  contentPadding = 0,
  mobileBreakpoint = 'md',
  disabled = false,
  layout = 'default',
  sideNavCollapsed = false,
  asideCollapsed = false,
  headerHidden = false,
  headerOffset = true,
  className,
} = Astro.props;

const s = appShell({
  height,
  variant,
  contentPadding: `${contentPadding}` as `${AppShellContentPadding}`,
});
const hasAside = Astro.slots.has('aside');
const hasSideNav = Astro.slots.has('sideNav');
const hasTopNav = Astro.slots.has('topNav');
const hasBanner = Astro.slots.has('banner');
const hasMobileNav = Astro.slots.has('mobileNav');
---

{
  disabled ? (
    <main id="var-ui-app-shell-main" {...mergeProps(s.main, className)}>
      <slot />
    </main>
  ) : (
    <div
      {...mergeProps(s.root, className)}
      data-var-ui-app-shell
      data-var-ui-mobile-nav-provider
      data-mobile-breakpoint={mobileBreakpoint}
      data-aside={hasAside || undefined}
      data-has-top-nav={hasTopNav || undefined}
      data-has-side-nav={hasSideNav || undefined}
      data-layout={layout === 'alt' ? 'alt' : undefined}
      data-side-nav-collapsed={sideNavCollapsed || undefined}
      data-aside-collapsed={asideCollapsed || undefined}
      data-header-hidden={headerHidden ? '' : undefined}
      data-header-offset={headerOffset ? '' : undefined}
    >
      <a href="#var-ui-app-shell-main" {...mergeProps(s.skipLink)}>Skip to content</a>
      {hasBanner && <div {...mergeProps(s.banner)}><slot name="banner" /></div>}
      <div {...mergeProps(s.frame)}>
        {hasTopNav && <header {...mergeProps(s.topNav)}><slot name="topNav" /></header>}
        {hasSideNav && <div {...mergeProps(s.sideNav)}><slot name="sideNav" /></div>}
        <main id="var-ui-app-shell-main" {...mergeProps(s.main)}><slot /></main>
        {hasAside && <aside {...mergeProps(s.aside)}><slot name="aside" /></aside>}
      </div>
      {hasMobileNav && <slot name="mobileNav" />}
    </div>
  )
}

<script>
  import { initAppShells } from '../scripts/appShell';
  import { initMobileNavChrome } from '../scripts/mobileNav';
  initAppShells();
  initMobileNavChrome();
</script>
