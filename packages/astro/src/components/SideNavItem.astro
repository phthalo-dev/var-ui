---
import { sideNav } from '@var-ui/core/components/sideNav';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'a'>, 'class:list' | 'href'> & {
  label: string;
  href?: string;
  isSelected?: boolean;
  isDisabled?: boolean;
  className?: string;
};

const {
  label,
  href,
  isSelected = false,
  isDisabled = false,
  className,
  ...rest
} = Astro.props;
const s = sideNav();
const sharedProps = {
  ...mergeProps(s.item, className),
  'data-selected': isSelected || undefined,
  'data-disabled': isDisabled || undefined,
  'aria-current': isSelected ? ('page' as const) : undefined,
};
---

{
  href ? (
    <a {...rest} href={href} {...sharedProps}>
      <slot name="icon" />
      <span {...mergeProps(s.itemLabel)}>{label}</span>
      {Astro.slots.has('end') ? <slot name="end" /> : null}
    </a>
  ) : (
    <button type="button" {...(rest as object)} disabled={isDisabled} {...sharedProps}>
      <slot name="icon" />
      <span {...mergeProps(s.itemLabel)}>{label}</span>
      {Astro.slots.has('end') ? <slot name="end" /> : null}
    </button>
  )
}
