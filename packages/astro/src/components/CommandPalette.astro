---
import type { HTMLAttributes } from 'astro/types';
import type { ComponentAttrsResult } from 'typestyles';
import { commandPalette } from '@var-ui/core/components/commandPalette';
import { mergeProps } from '../utils';
import type { CommandPaletteItem } from '../scripts/commandPaletteUtils';

type CommandPaletteSlot =
  | 'root'
  | 'frame'
  | 'inputRow'
  | 'inputIcon'
  | 'input'
  | 'results'
  | 'resultLink'
  | 'resultLinkActive'
  | 'resultBody'
  | 'resultTitle'
  | 'resultMeta'
  | 'empty';
type CommandPaletteSlots = Record<CommandPaletteSlot, ComponentAttrsResult>;
type CommandPaletteRecipeFn = () => CommandPaletteSlots;

/** Native attributes are forwarded to the `<dialog>` element (the React peer does the same). */
type Props = Omit<HTMLAttributes<'dialog'>, 'id' | 'class:list'> & {
  id: string;
  items: CommandPaletteItem[];
  placeholder?: string;
  'aria-label'?: string;
  hotkey?: boolean;
  className?: string;
};

const {
  id,
  items,
  placeholder = 'Search…',
  'aria-label': ariaLabel = placeholder,
  hotkey = true,
  className,
  ...rest
} = Astro.props;

const indexJson = JSON.stringify(items);
const cp = (commandPalette as unknown as CommandPaletteRecipeFn)();
const dialogRecipe = mergeProps(cp.root);
const frameRecipe = mergeProps(cp.frame);
const inputRowRecipe = mergeProps(cp.inputRow);
const inputIconRecipe = mergeProps(cp.inputIcon);
const inputRecipe = mergeProps(cp.input);
const resultsRecipe = mergeProps(cp.results);
const resultLinkClass = (cp.resultLink).className;
const resultLinkActiveClass = (cp.resultLinkActive).className;
const resultBodyClass = (cp.resultBody).className;
const resultTitleClass = (cp.resultTitle).className;
const resultMetaClass = (cp.resultMeta).className;
const emptyClass = (cp.empty).className;
---

<div
  id={id}
  class:list={['', className]}
  data-var-ui-command-palette-root
  data-command-palette-id={id}
  data-hotkey={hotkey ? 'true' : 'false'}
  data-class-result-link={resultLinkClass}
  data-class-result-link-active={resultLinkActiveClass}
  data-class-result-body={resultBodyClass}
  data-class-result-title={resultTitleClass}
  data-class-result-meta={resultMetaClass}
  data-class-empty={emptyClass}
  data-class-group="var-ui-command-palette__group"
  data-class-group-label="var-ui-command-palette__groupLabel"
>
  <dialog
    {...rest}
    {...dialogRecipe}
    id={`${id}-dialog`}
    data-var-ui-command-palette-dialog
    aria-label={ariaLabel}
  >
    <div {...frameRecipe}>
      <div {...inputRowRecipe}>
        <span {...inputIconRecipe} aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="18"
            height="18"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M16.5 16.5L21 21"></path>
          </svg>
        </span>
        <input
          {...inputRecipe}
          type="search"
          data-var-ui-command-palette-input
          placeholder={placeholder}
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-autocomplete="list"
          aria-controls={`${id}-results`}
          aria-expanded="false"
        />
      </div>
      <div
        {...resultsRecipe}
        id={`${id}-results`}
        data-var-ui-command-palette-results
        role="listbox"
      >
      </div>
    </div>
  </dialog>

  <script is:inline type="application/json" data-var-ui-command-palette-items set:html={indexJson} />
</div>

<script>
  import { initCommandPalettes } from '../scripts/commandPalette';
  initCommandPalettes();
</script>
