---
import type { HTMLAttributes } from 'astro/types';
import type { ComponentAttrsResult } from 'typestyles';
import { commandPalette } from '@var-ui/core/components/commandPalette';
import { defaultIconSvgs } from '@var-ui/icons/glyphs';
import { mergeProps } from '../utils';
import Kbd from './Kbd.astro';
import type {
  CommandPaletteClientItem,
  CommandPaletteItem,
} from '../scripts/commandPaletteUtils';

type CommandPaletteSlot =
  | 'root'
  | 'frame'
  | 'inputRow'
  | 'inputIcon'
  | 'input'
  | 'results'
  | 'resultLink'
  | 'resultLinkActive'
  | 'resultBody'
  | 'resultTitle'
  | 'resultMeta'
  | 'resultIcon'
  | 'mark'
  | 'group'
  | 'groupHeading'
  | 'footer'
  | 'footerHint'
  | 'empty'
  | 'emptyIcon'
  | 'emptyTitle'
  | 'emptyHint'
  | 'cancel';
type CommandPaletteSlots = Record<CommandPaletteSlot, ComponentAttrsResult>;
type CommandPaletteRecipeFn = () => CommandPaletteSlots;

/** Native attributes are forwarded to the `<dialog>` element (the React peer does the same). */
type Props = Omit<HTMLAttributes<'dialog'>, 'id' | 'class:list'> & {
  id: string;
  items: CommandPaletteItem[];
  placeholder?: string;
  'aria-label'?: string;
  hotkey?: boolean;
  /** Keyboard hints under the results (↑↓ navigate, ↵ open, esc close). @default true */
  hints?: boolean;
  /**
   * Wraps the part of each title and meta that matches the query in a `<mark>`. Pass `false` to
   * render plain text. @default true
   */
  highlightMatches?: boolean;
  /**
   * Remembers chosen items in `localStorage` under this key and lists them under a "Recent"
   * heading while the query is empty. Omit to keep no history.
   */
  recentKey?: string;
  /** Heading of the recent items group (see `recentKey`). @default 'Recent' */
  recentLabel?: string;
  /** Message shown when no items match the query, followed by the query. @default 'No results' */
  emptyLabel?: string;
  /** Second line of the empty state, e.g. a suggestion ("Try 'button'"). */
  emptyHint?: string;
  /** Label of the Cancel button shown on touch-first devices (no Escape key). @default 'Cancel' */
  cancelLabel?: string;
  className?: string;
};

const {
  id,
  items,
  placeholder = 'Search…',
  'aria-label': ariaLabel = placeholder,
  hotkey = true,
  hints = true,
  highlightMatches = true,
  recentKey,
  recentLabel = 'Recent',
  emptyLabel = 'No results',
  emptyHint,
  cancelLabel = 'Cancel',
  className,
  ...rest
} = Astro.props;

const iconSvgs: Record<string, string> = defaultIconSvgs;
const clientItems: CommandPaletteClientItem[] = items.map(({ icon, ...item }) =>
  icon && iconSvgs[icon] ? { ...item, iconSvg: iconSvgs[icon] } : item,
);
const indexJson = JSON.stringify(clientItems);
const cp = (commandPalette as unknown as CommandPaletteRecipeFn)();
const dialogRecipe = mergeProps(cp.root);
const frameRecipe = mergeProps(cp.frame);
const inputRowRecipe = mergeProps(cp.inputRow);
const inputIconRecipe = mergeProps(cp.inputIcon);
const inputRecipe = mergeProps(cp.input);
const resultsRecipe = mergeProps(cp.results);
const resultLinkClass = (cp.resultLink).className;
const resultLinkActiveClass = (cp.resultLinkActive).className;
const resultBodyClass = (cp.resultBody).className;
const resultTitleClass = (cp.resultTitle).className;
const resultMetaClass = (cp.resultMeta).className;
const emptyClass = (cp.empty).className;
const cancelRecipe = mergeProps(cp.cancel);
const resultIconClass = cp.resultIcon.className;
const markClass = cp.mark.className;
const groupClass = cp.group.className;
const groupHeadingClass = cp.groupHeading.className;
const footerRecipe = mergeProps(cp.footer);
const footerHintRecipe = mergeProps(cp.footerHint);
---

<div
  id={id}
  class:list={['', className]}
  data-var-ui-command-palette-root
  data-command-palette-id={id}
  data-hotkey={hotkey ? 'true' : 'false'}
  data-class-result-link={resultLinkClass}
  data-class-result-link-active={resultLinkActiveClass}
  data-class-result-body={resultBodyClass}
  data-class-result-title={resultTitleClass}
  data-class-result-meta={resultMetaClass}
  data-class-empty={emptyClass}
  data-class-empty-icon={cp.emptyIcon.className}
  data-class-empty-title={cp.emptyTitle.className}
  data-class-empty-hint={cp.emptyHint.className}
  data-empty-hint={emptyHint}
  data-class-result-icon={resultIconClass}
  data-class-mark={markClass}
  data-highlight-matches={highlightMatches ? undefined : 'false'}
  data-recent-key={recentKey}
  data-recent-label={recentLabel}
  data-empty-label={emptyLabel}
  data-class-group={groupClass}
  data-class-group-heading={groupHeadingClass}
>
  <dialog
    {...rest}
    {...dialogRecipe}
    id={`${id}-dialog`}
    data-var-ui-command-palette-dialog
    aria-label={ariaLabel}
  >
    <div {...frameRecipe}>
      <div {...inputRowRecipe}>
        <span {...inputIconRecipe} aria-hidden="true" data-var-ui-command-palette-input-icon>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="18"
            height="18"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M16.5 16.5L21 21"></path>
          </svg>
        </span>
        <input
          {...inputRecipe}
          type="search"
          data-var-ui-command-palette-input
          placeholder={placeholder}
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-autocomplete="list"
          aria-controls={`${id}-results`}
          aria-expanded="false"
        />
        <button {...cancelRecipe} type="button" data-var-ui-command-palette-cancel>
          {cancelLabel}
        </button>
      </div>
      <div
        {...resultsRecipe}
        id={`${id}-results`}
        data-var-ui-command-palette-results
        role="listbox"
      >
      </div>
      {hints ? (
        <div {...footerRecipe} aria-hidden="true">
          <span {...footerHintRecipe}><Kbd>↑</Kbd><Kbd>↓</Kbd> to navigate</span>
          <span {...footerHintRecipe}><Kbd>↵</Kbd> to open</span>
          <span {...footerHintRecipe}><Kbd>esc</Kbd> to close</span>
        </div>
      ) : null}
    </div>
  </dialog>

  <script is:inline type="application/json" data-var-ui-command-palette-items set:html={indexJson} />
</div>

<script>
  import { initCommandPalettes } from '../scripts/commandPalette';
  initCommandPalettes();
</script>
