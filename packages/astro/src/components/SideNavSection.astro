---
import SideNavSectionHeader from './SideNavSectionHeader.astro';
import { sideNav } from '@var-ui/core/components/sideNav';
import { svg as chevronSvg } from '@var-ui/icons/glyphs/chevronDown';
import Text from './Text.astro';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'div'>, 'class:list' | 'title'> & {
  title?: string;
  subtitle?: string;
  /**
   * Render the section as a disclosure (`<details>`): the title row toggles the items and sticks
   * to the top of the scroll area. Needs a `title`. @default false
   */
  collapsible?: boolean;
  /** Initial open state of a collapsible section. @default true */
  defaultOpen?: boolean;
  /** Item count shown after the title of a collapsible section. */
  count?: number;
  className?: string;
};

const {
  title,
  subtitle,
  collapsible = false,
  defaultOpen = true,
  count,
  className,
  ...rest
} = Astro.props;
const s = sideNav();
const hasTitleSlot = Astro.slots.has('title');
const showHeader = hasTitleSlot || title != null || subtitle != null || Astro.slots.has('end');
---

{
  collapsible && title != null ? (
    <details
      {...(rest as Record<string, unknown>)}
      {...mergeProps(s.section, className)}
      open={defaultOpen || undefined}
      data-collapsible
    >
      <summary {...mergeProps(s.sectionSummary)}>
        <SideNavSectionHeader title={title} />
        {count != null ? <span {...mergeProps(s.sectionCount)}>{count}</span> : null}
        <span {...mergeProps(s.sectionChevron)} aria-hidden="true" set:html={chevronSvg} />
      </summary>
      <div {...mergeProps(s.sectionItems)}>
        <slot />
      </div>
    </details>
  ) : (
    <div {...rest} {...mergeProps(s.section, className)}>
      {
        showHeader && (
          <div {...mergeProps(s.sectionHeader)}>
            <div {...mergeProps(s.sectionTitles)}>
              {hasTitleSlot ? <slot name="title" /> : title != null ? <SideNavSectionHeader title={title} /> : null}
              {subtitle != null ? (
                <Text as="span" size="sm" tone="secondary">
                  {subtitle}
                </Text>
              ) : null}
            </div>
            {Astro.slots.has('end') ? <slot name="end" /> : null}
          </div>
        )
      }
      <slot />
    </div>
  )
}
