---
import { skeleton } from '@var-ui/core/components/skeleton';
import type { SkeletonVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  shape?: NonNullable<SkeletonVariantProps['shape']>;
  className?: string;
  style?: string;
};

const { shape = 'text', className, style } = Astro.props;
const rp = mergeProps(skeleton({ shape }), className);
---
<div {...rp} aria-hidden="true" style={style} />
