---
import { resizeHandle } from '@var-ui/core/components/resizeHandle';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'div'>, 'class:list'> & {
  className?: string;
};

const { className, 'aria-label': ariaLabel = 'Resize', ...rest } = Astro.props;
const s = resizeHandle();
---

<div
  data-orientation="horizontal"
  aria-label={ariaLabel}
  {...rest}
  data-var-ui-side-nav-resize
  {...mergeProps(s.root, className)}
>
  <div {...mergeProps(s.pill)}></div>
</div>
