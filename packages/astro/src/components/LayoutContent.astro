---
import type { HTMLAttributes } from 'astro/types';
import { layoutContent } from '@var-ui/core/components/layout';
import type { LayoutContentVariantProps, LayoutPadding } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  padding?: LayoutPadding;
  isScrollable?: boolean;
  role?: NonNullable<HTMLAttributes<'div'>['role']>;
  label?: string;
  className?: string;
};

/** `layoutContent()` only supports seamless (`inherit`, the default) or `0`. */
function toZonePaddingVariant(
  padding: LayoutPadding | undefined,
): NonNullable<LayoutContentVariantProps['padding']> {
  return padding === 0 ? '0' : 'inherit';
}

const { padding, isScrollable = true, role, label, className } = Astro.props;
const s = layoutContent({ isScrollable, padding: toZonePaddingVariant(padding) });
const resolvedRole = role ?? (label != null ? 'region' : undefined);
---

<div {...mergeProps(s.content, className)} role={resolvedRole} aria-label={label}>
  <slot />
</div>
