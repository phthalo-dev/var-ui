---
import type { HTMLAttributes } from 'astro/types';
import { mobileNav } from '@var-ui/core/components/mobileNav';
import { mergeProps } from '../utils';

/**
 * Native attributes and `className` go to the native `<dialog>` (as in React): the panel is the
 * dialog. `aria-label` / `aria-labelledby` name it and take precedence over `label`.
 */
type Props = Omit<HTMLAttributes<'dialog'>, 'class:list' | 'open'> & {
  header?: string;
  width?: number;
  side?: 'start' | 'end' | 'auto';
  closeLabel?: string;
  label?: string;
  className?: string;
};

const {
  header,
  width = 320,
  side = 'auto',
  closeLabel = 'Close navigation',
  label = 'Navigation',
  className,
  'aria-label': ariaLabel,
  'aria-labelledby': ariaLabelledBy,
  ...rest
} = Astro.props;

const s = mobileNav();
const resolvedSide = side === 'auto' ? 'start' : side;
const panelStyle = `--var-ui-mobile-nav-panelwidth: ${width}px`;
const hasHeaderSlot = Astro.slots.has('header');
---

<div data-var-ui-mobile-nav>
  <dialog
    {...rest}
    data-var-ui-mobile-nav-popup
    data-side={resolvedSide}
    aria-label={ariaLabel ?? (ariaLabelledBy ? undefined : label)}
    aria-labelledby={ariaLabelledBy}
    style={panelStyle}
    {...mergeProps(s.popup, className)}
  >
    <div {...mergeProps(s.header)}>
      <div class="mobile-nav__header-content">
        {hasHeaderSlot ? <slot name="header" /> : header}
      </div>
      <button
        type="button"
        data-var-ui-mobile-nav-close
        aria-label={closeLabel}
        {...mergeProps(s.closeButton)}
      ></button>
    </div>
    <slot />
  </dialog>
</div>

<style>
  .mobile-nav__header-content {
    min-width: 0;
  }
</style>

<script>
  import { initMobileNavs } from '../scripts/mobileNav';
  initMobileNavs();
</script>
