---
import type { HTMLAttributes } from 'astro/types';
import { progressCircle } from '@var-ui/core/components/progressCircle';
import type { ProgressCircleVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

/**
 * Circular progress (static). Same DOM and classes as the React `ProgressCircle`. The default
 * slot is centered inside the ring. Indeterminate when `value` is omitted or `indeterminate` is set.
 */
type Props = Omit<HTMLAttributes<'div'>, 'children' | 'role'> &
  ProgressCircleVariantProps & {
    value?: number;
    min?: number;
    max?: number;
    /** Accessible name (`aria-label`). */
    label?: string;
    /** Spoken value (`aria-valuetext`). */
    valueLabel?: string;
    className?: string;
  };

const {
  value,
  min = 0,
  max = 100,
  label,
  valueLabel,
  size = 'md',
  tone = 'accent',
  appearance = 'solid',
  indeterminate,
  className,
  style,
  ...rest
} = Astro.props;

const isIndeterminate = indeterminate ?? value === undefined;
const p = progressCircle({ size, tone, appearance, indeterminate: isIndeterminate });
const clamped = Math.min(max, Math.max(min, value ?? min));
const fraction = max === min ? 0 : (clamped - min) / (max - min);
const valueText = valueLabel ?? `${Math.round(fraction * 100)}%`;
const hasContent = Astro.slots.has('default');
const ringStyle = isIndeterminate
  ? undefined
  : `--var-ui-progress-circle-progress: ${fraction}`;
---
<div
  aria-label={label}
  {...rest}
  {...mergeProps(p.root, className)}
  style={style}
  role="progressbar"
  aria-valuemin={isIndeterminate ? undefined : min}
  aria-valuemax={isIndeterminate ? undefined : max}
  aria-valuenow={isIndeterminate ? undefined : clamped}
  aria-valuetext={isIndeterminate ? undefined : valueText}
>
  <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false" {...mergeProps(p.ring)} style={ringStyle}>
    <circle cx="50" cy="50" r="42" pathLength="100" {...mergeProps(p.track)} />
    <circle cx="50" cy="50" r="42" pathLength="100" {...mergeProps(p.fill)} />
  </svg>
  {hasContent ? <span {...mergeProps(p.content)}><slot /></span> : null}
</div>
