---
import type { HTMLAttributes } from 'astro/types';
import { hiddenClassName } from '@var-ui/core/components/hidden';
import type { HiddenMap } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'div'>, 'class:list'> & {
  hide?: boolean | HiddenMap;
  as?: string;
  className?: string;
};

const { hide, as = 'div', className, ...rest } = Astro.props;
const rp = mergeProps(hiddenClassName({ hide }), className);
const Tag = as;
---
<Tag {...rest} {...rp}><slot /></Tag>
