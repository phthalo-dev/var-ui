---
import { badge } from '@var-ui/core/components/badge';
import type { BadgeVariantProps } from '@var-ui/core';
import { mergeProps } from '../utils';

interface Props extends BadgeVariantProps {
  className?: string;
}

const { tone = 'neutral', appearance = 'subtle', className } = Astro.props;
const rp = mergeProps(badge({ tone, appearance }), className);
---
<span {...rp}><slot /></span>
