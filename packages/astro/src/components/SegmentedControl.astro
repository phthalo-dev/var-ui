---
import type { HTMLAttributes } from 'astro/types';
import { segmentedControl } from '@var-ui/core/components/segmentedControl';
import { toggleButton } from '@var-ui/core/components/toggleButton';
import type { SegmentedControlVariantProps } from '@var-ui/core';
import { mergeProps } from "../utils";

type SegmentOption = {
  id: string;
  label: string;
  /** Accessible name when the slotted content is not plain text (e.g. icon-only segments). */
  "aria-label"?: string;
};

type Props = Omit<HTMLAttributes<'div'>, 'class'> & {
  /** Segment definitions. Render rich content (e.g. icons) via a named slot matching each `id`. */
  options: SegmentOption[];
  /** Initially selected segment id. Defaults to the first option. */
  selectedId?: string;
  size?: NonNullable<SegmentedControlVariantProps['size']>;
  className?: string;
  /** Accessible name for the group. */
  "aria-label"?: string;
};

const {
  options,
  selectedId = options[0]?.id,
  size = "md",
  className,
  "aria-label": ariaLabel,
  ...rest
} = Astro.props;

const s = segmentedControl({ size });
const segmentRecipe = mergeProps(toggleButton({ segmented: true }));

const optionContent = await Promise.all(
  options.map(async (option) => ({
    id: option.id,
    content: Astro.slots.has(option.id)
      ? await Astro.slots.render(option.id)
      : null,
  })),
);
---

<div
  role="group"
  {...rest}
  aria-label={ariaLabel}
  data-var-ui-segmented-control
  {...mergeProps(s.root, className)}
>
  {options.map((option) => {
    const selected = option.id === selectedId;
    const content = optionContent.find(
      (entry) => entry.id === option.id,
    )?.content;
    return (
      <button
        type="button"
        data-segment-id={option.id}
        aria-pressed={selected ? "true" : "false"}
        data-selected={selected ? "" : undefined}
        aria-label={option["aria-label"]}
        {...segmentRecipe}
      >
        {content ? <Fragment set:html={content} /> : option.label}
      </button>
    );
  })}
</div>

<script>
  import { initSegmentedControls } from "../scripts/segmentedControl";
  initSegmentedControls();
</script>
