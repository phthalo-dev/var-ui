---
import type { HTMLAttributes } from 'astro/types';
import { segmentedControl } from '@var-ui/core/components/segmentedControl';
import { toggleButton } from '@var-ui/core/components/toggleButton';
import type { ControlSize } from '@var-ui/core';
import { mergeProps } from "../utils";
import { segmentedControlName } from "../scripts/segmentedControl";
import { icon as iconStyles } from '@var-ui/core/components/icon';
import { iconMarkup, type AstroIcon } from "../lib/icon";

type SegmentOption = {
  /** Unique value; also the name of the optional slot that renders rich content. */
  value: string;
  label: string;
  disabled?: boolean;
  /**
   * Icon before the label: a registry name or `{ svg }` markup. With `layout="icon"` only the
   * icon shows and `label` becomes the segment's accessible name and tooltip.
   */
  icon?: AstroIcon;
  /** Accessible name when the slotted content is not plain text. Defaults to `label` for icon-only segments. */
  "aria-label"?: string;
};

type Props = Omit<HTMLAttributes<'div'>, 'class' | 'role'> & {
  /** Segment definitions. Render rich content (e.g. icons) via a named slot matching each `value`. */
  options: SegmentOption[];
  /** Initially selected segment value. Defaults to the first option. */
  defaultValue?: string;
  /**
   * Radio group name (also submitted with a form). Defaults to a name derived from the page path
   * and the control's position on the page, stable across builds.
   */
  name?: string;
  /** Disables every segment. */
  disabled?: boolean;
  size?: ControlSize;
  /** `icon` renders square, icon-only segments (give each option an `aria-label`). */
  layout?: "default" | "icon";
  /** Fills the container's width, with equal-width segments. @default false */
  fullWidth?: boolean;
  className?: string;
  /** Accessible name for the group. */
  "aria-label"?: string;
};

const {
  options,
  defaultValue = options[0]?.value,
  name = segmentedControlName(Astro.request, Astro.url.pathname),
  disabled = false,
  size = "md",
  layout = "default",
  fullWidth = false,
  className,
  "aria-label": ariaLabel,
  ...rest
} = Astro.props;

const s = segmentedControl({ size, layout, fullWidth });
// Same control-size → icon-size map as IconButton.
const iconRecipe = mergeProps(iconStyles({ size }));
const iconOnly = layout === "icon";
const segmentRecipe = mergeProps(toggleButton({ segmented: true }));

const optionContent = await Promise.all(
  options.map(async (option) => ({
    value: option.value,
    content: Astro.slots.has(option.value)
      ? await Astro.slots.render(option.value)
      : null,
  })),
);
---

{/*
  A radio group (APG): Tab lands on the checked segment, arrow keys move and check. Each segment
  is a <label> around a native radio, so the browser provides the roving focus and form value.
*/}
<div
  role="radiogroup"
  {...rest}
  aria-label={ariaLabel}
  aria-disabled={disabled ? "true" : undefined}
  data-var-ui-segmented-control
  {...mergeProps(s.root, className)}
>
  {options.map((option) => {
    const selected = option.value === defaultValue;
    const optionDisabled = disabled || option.disabled === true;
    const content = optionContent.find(
      (entry) => entry.value === option.value,
    )?.content;
    return (
      <label
        data-var-ui-segment-id={option.value}
        data-selected={selected ? "" : undefined}
        data-disabled={optionDisabled ? "" : undefined}
        title={iconOnly ? (option["aria-label"] ?? option.label) : undefined}
        {...segmentRecipe}
      >
        <input
          type="radio"
          name={name}
          value={option.value}
          checked={selected}
          disabled={optionDisabled}
          aria-label={option["aria-label"] ?? (iconOnly && option.icon ? option.label : undefined)}
        />
        {content ? (
          <Fragment set:html={content} />
        ) : (
          <>
            {option.icon ? (
              <span {...iconRecipe} aria-hidden="true" set:html={iconMarkup(option.icon)} />
            ) : null}
            {iconOnly && option.icon ? null : option.label}
          </>
        )}
      </label>
    );
  })}
</div>

<script>
  import { initSegmentedControls } from "../scripts/segmentedControl";
  initSegmentedControls();
  document.addEventListener("astro:page-load", () => initSegmentedControls());
</script>
