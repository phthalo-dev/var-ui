---
import type { HTMLAttributes } from 'astro/types';
import { link } from '@var-ui/core';
import { mergeProps } from '../utils';

type Props = {
  href: string;
  className?: string;
  target?: string;
  rel?: string;
  download?: string | boolean;
  hreflang?: string;
  referrerpolicy?: NonNullable<HTMLAttributes<'a'>['referrerpolicy']>;
  title?: string;
};

const { href, className, ...rest } = Astro.props;
---

<a href={href} {...rest} {...mergeProps(link, className)}><slot /></a>
