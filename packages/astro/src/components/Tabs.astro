---
import type { HTMLAttributes } from 'astro/types';
import { tabs as tabsRecipe, type TabsAppearance, type TabsSize } from '@var-ui/core/components/tabs';
import { mergeProps } from '../utils';
import { tabIds } from '../lib/tabIds';

type TabDef = { value: string; label: string; disabled?: boolean };

type Props = Omit<HTMLAttributes<'div'>, 'children'> & {
  tabs: TabDef[];
  defaultValue?: string;
  /**
   * Scopes the tab and panel ids (`<id>-tab-<value>`), so several tab sets on one page never
   * collide. Give it explicitly to render panels elsewhere with `<TabPanel tabs={id}>`.
   */
  id?: string;
  /**
   * `false` renders only the tab list: render each panel with `<TabPanel tabs={id} value>` in
   * any layout region (the tabs find their panels by id, not by DOM nesting). @default true
   */
  panels?: boolean;
  /** Underline rail or pill buttons. @default 'underline' */
  appearance?: TabsAppearance;
  /** `sm` is a compact row for side panels and toolbars. @default 'md' */
  size?: TabsSize;
  className?: string;
};

const {
  tabs,
  defaultValue,
  id = `tabs-${Math.random().toString(36).slice(2, 8)}`,
  panels = true,
  appearance = 'underline',
  size = 'md',
  className,
  ...rest
} = Astro.props;
const selected = defaultValue ?? tabs[0]?.value;
const t = tabsRecipe({ appearance, size });

const panelSlots = panels
  ? await Promise.all(
      tabs.map(async (tab) => ({
        value: tab.value,
        content: Astro.slots.has(tab.value) ? await Astro.slots.render(tab.value) : null,
      })),
    )
  : [];
---

<div {...rest} id={id} data-var-ui-tabs {...mergeProps(t.root, className)}>
  <div role="tablist" {...mergeProps(t.list)}>
    {tabs.map((tab) => {
      const ids = tabIds(id, tab.value);
      return (
        <button
          type="button"
          role="tab"
          id={ids.tab}
          aria-controls={ids.panel}
          aria-selected={tab.value === selected ? 'true' : 'false'}
          tabindex={tab.value === selected ? 0 : -1}
          data-selected={tab.value === selected ? '' : undefined}
          disabled={tab.disabled || undefined}
          data-disabled={tab.disabled ? '' : undefined}
          {...mergeProps(t.tab)}
        >
          {tab.label}
        </button>
      );
    })}
  </div>
  {panels &&
    tabs.map((tab) => {
      const ids = tabIds(id, tab.value);
      const slotContent = panelSlots.find((panel) => panel.value === tab.value)?.content;
      return (
        <div
          role="tabpanel"
          id={ids.panel}
          aria-labelledby={ids.tab}
          hidden={tab.value !== selected ? true : undefined}
          {...mergeProps(t.panel)}
        >
          {slotContent ? <Fragment set:html={slotContent} /> : null}
        </div>
      );
    })}
</div>

<script>
  import { createTabsController } from '../scripts/tabs';
  const init = () =>
    document.querySelectorAll('[data-var-ui-tabs]').forEach((root) => {
      createTabsController(root as HTMLElement);
    });
  init();
  document.addEventListener('astro:page-load', init);
</script>
