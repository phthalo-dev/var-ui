---
import type { HTMLAttributes } from 'astro/types';
import { tabs as tabsRecipe } from '@var-ui/core/components/tabs';
import { mergeProps } from "../utils";

type TabDef = { value: string; label: string; disabled?: boolean };

type Props = Omit<HTMLAttributes<'div'>, 'children'> & {
  tabs: TabDef[];
  defaultValue?: string;
  className?: string;
};

const { tabs, defaultValue, className, ...rest } = Astro.props;
const selected = defaultValue ?? tabs[0]?.value;
const t = tabsRecipe();

const panelSlots = await Promise.all(
  tabs.map(async (tab) => ({
    value: tab.value,
    content: Astro.slots.has(tab.value) ? await Astro.slots.render(tab.value) : null,
  })),
);
---

<div {...rest} data-var-ui-tabs {...mergeProps(t.root, className)}>
  <div role="tablist" {...mergeProps(t.list)}>
    {tabs.map((tab) => (
      <button
        type="button"
        role="tab"
        id={`tab-${tab.value}`}
        aria-controls={`panel-${tab.value}`}
        aria-selected={tab.value === selected ? "true" : "false"}
        tabindex={tab.value === selected ? 0 : -1}
        data-selected={tab.value === selected ? "" : undefined}
        disabled={tab.disabled || undefined}
        data-disabled={tab.disabled ? "" : undefined}
        {...mergeProps(t.tab)}
      >
        {tab.label}
      </button>
    ))}
  </div>
  {tabs.map((tab) => {
    const slotContent = panelSlots.find(
      (panel) => panel.value === tab.value,
    )?.content;
    return (
      <div
        role="tabpanel"
        id={`panel-${tab.value}`}
        aria-labelledby={`tab-${tab.value}`}
        hidden={tab.value !== selected ? true : undefined}
        {...mergeProps(t.panel)}
      >
        {slotContent ? <Fragment set:html={slotContent} /> : null}
      </div>
    );
  })}
</div>

<script>
  import { createTabsController } from "../scripts/tabs";
  document.querySelectorAll("[data-var-ui-tabs]").forEach((root) => {
    createTabsController(root as HTMLElement);
  });
</script>
