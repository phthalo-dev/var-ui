---
import { topNav } from '@var-ui/core/components/topNav';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'a'>, 'class:list' | 'href'> & {
  label: string;
  href?: string;
  isSelected?: boolean;
  isDisabled?: boolean;
  isIconOnly?: boolean;
  className?: string;
};

const {
  label,
  href,
  isSelected = false,
  isDisabled = false,
  isIconOnly = false,
  className,
  ...rest
} = Astro.props;
const s = topNav();
const sharedProps = {
  ...mergeProps(s.item, className),
  'data-selected': isSelected || undefined,
  'data-disabled': isDisabled || undefined,
  'aria-current': isSelected ? ('page' as const) : undefined,
  'aria-label': isIconOnly ? label : undefined,
};
---

{
  href ? (
    <a {...rest} href={href} {...sharedProps}>
      <slot name="icon" />
      {!isIconOnly ? <span>{label}</span> : null}
      {!isIconOnly && Astro.slots.has('end') ? <slot name="end" /> : null}
    </a>
  ) : (
    <button type="button" {...(rest as object)} disabled={isDisabled} {...sharedProps}>
      <slot name="icon" />
      {!isIconOnly ? <span>{label}</span> : null}
      {!isIconOnly && Astro.slots.has('end') ? <slot name="end" /> : null}
    </button>
  )
}
