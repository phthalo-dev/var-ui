---
import { topNav } from '@var-ui/core/components/topNav';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from '../utils';

type Props = Omit<HTMLAttributes<'a'>, 'class:list' | 'href'> & {
  label: string;
  href?: string;
  selected?: boolean;
  disabled?: boolean;
  iconOnly?: boolean;
  className?: string;
};

const {
  label,
  href,
  selected = false,
  disabled = false,
  iconOnly = false,
  className,
  ...rest
} = Astro.props;
const s = topNav();
const sharedProps = {
  ...mergeProps(s.item, className),
  'data-selected': selected || undefined,
  'data-disabled': disabled || undefined,
  'aria-current': selected ? ('page' as const) : undefined,
  'aria-label': iconOnly ? label : undefined,
};
---

{
  href ? (
    <a {...rest} href={href} {...sharedProps}>
      <slot name="icon" />
      {!iconOnly ? <span>{label}</span> : null}
      {!iconOnly && Astro.slots.has('end') ? <slot name="end" /> : null}
    </a>
  ) : (
    <button type="button" {...(rest as object)} disabled={disabled} {...sharedProps}>
      <slot name="icon" />
      {!iconOnly ? <span>{label}</span> : null}
      {!iconOnly && Astro.slots.has('end') ? <slot name="end" /> : null}
    </button>
  )
}
