---
import type { HTMLAttributes } from 'astro/types';
import { aspectRatio } from '@var-ui/core/components/aspectRatio';
import { mergeProps } from '../utils';

type Props = HTMLAttributes<'div'> & {
  ratio?: number;
  className?: string;
};

const { ratio, className, style, ...rest } = Astro.props;
const baseStyle = typeof style === 'string' ? style : undefined;
const ratioStyle = [ratio ? `aspect-ratio: ${ratio}` : undefined, baseStyle].filter(Boolean).join('; ') || undefined;
const rp = mergeProps(aspectRatio(), className);
---
<div {...rest} {...rp} style={ratioStyle}><slot /></div>
