---
import { emptyState } from '@var-ui/core/components/emptyState';
import { mergeProps } from '../utils';

type Props = {
  title: string;
  description?: string;
  className?: string;
};

const { title, description, className } = Astro.props;
const e = emptyState();
const hasIcon = Astro.slots.has('icon');
const hasAction = Astro.slots.has('action');
---
<div {...mergeProps(e.root, className)}>
  {
    hasIcon ? (
      <div {...mergeProps(e.icon)} data-empty-state-icon aria-hidden="true">
        <slot name="icon" />
      </div>
    ) : null
  }
  <h3 {...mergeProps(e.title)}>{title}</h3>
  {description ? <p {...mergeProps(e.description)}>{description}</p> : null}
  {
    hasAction ? (
      <div {...mergeProps(e.action)}>
        <slot name="action" />
      </div>
    ) : null
  }
</div>
