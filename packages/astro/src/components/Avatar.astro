---
import type { HTMLAttributes } from 'astro/types';
import { avatar } from '@var-ui/core/components/avatar';
import { statusDot } from '@var-ui/core/components/statusDot';
import type { AvatarVariantProps, Tone } from '@var-ui/core';
import { mergeProps } from '../utils';

interface Props extends Omit<HTMLAttributes<'span'>, 'children'>, AvatarVariantProps {
  src?: string;
  alt?: string;
  name?: string;
  status?: Tone;
  className?: string;
}

function initialsOf(name: string): string {
  return name
    .split(/\s+/)
    .slice(0, 2)
    .map((word) => word[0] ?? '')
    .join('');
}

const { src, alt, name, size = 'md', status, className, ...rest } = Astro.props;
const a = avatar({ size });
const accessibleName = alt ?? name;
const showImage = Boolean(src);
---
<span {...rest} {...mergeProps(a.root, className)}>
  {
    showImage ? (
      <>
        <img
          {...mergeProps(a.image)}
          src={src}
          alt={accessibleName ?? ''}
          onerror="this.hidden=true;this.nextElementSibling.hidden=false"
        />
        <span
          {...mergeProps(a.initials)}
          hidden
          aria-hidden={accessibleName ? undefined : true}
          role={accessibleName ? 'img' : undefined}
          aria-label={accessibleName}
        >
          {name ? initialsOf(name) : '?'}
        </span>
      </>
    ) : (
      <span
        {...mergeProps(a.initials)}
        aria-hidden={accessibleName ? undefined : true}
        role={accessibleName ? 'img' : undefined}
        aria-label={accessibleName}
      >
        {name ? initialsOf(name) : '?'}
      </span>
    )
  }
  {
    status ? (
      <span {...mergeProps(a.status)} data-avatar-status>
        <span {...mergeProps(statusDot({ tone: status }))} />
      </span>
    ) : null
  }
</span>
