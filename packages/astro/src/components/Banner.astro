---
import type { HTMLAttributes } from 'astro/types';
import { banner } from '@var-ui/core/components/banner';
import type { BannerVariantProps } from '@var-ui/core';
import { svg as closeSvg } from '@var-ui/icons/glyphs/close';
import { mergeProps } from '../utils';

interface Props extends Omit<HTMLAttributes<'div'>, 'title'>, BannerVariantProps {
  title?: string;
  dismissible?: boolean;
  dismissLabel?: string;
  className?: string;
}

const {
  tone = 'info',
  appearance = 'subtle',
  title,
  dismissible = false,
  dismissLabel = 'Dismiss',
  className,
  ...rest
} = Astro.props;

const b = banner({ tone, appearance });
const hasIcon = Astro.slots.has('icon');
const hasActions = Astro.slots.has('actions');
const role = tone === 'warning' || tone === 'danger' ? 'alert' : 'status';
---

<div role={role} {...rest} {...mergeProps(b.root, className)} data-banner>
  {
    hasIcon ? (
      <span {...mergeProps(b.icon)}>
        <slot name="icon" />
      </span>
    ) : null
  }
  <div {...mergeProps(b.content)}>
    {title ? <span {...mergeProps(b.title)}>{title}</span> : null}
    <span><slot /></span>
  </div>
  {
    hasActions ? (
      <div {...mergeProps(b.actions)}>
        <slot name="actions" />
      </div>
    ) : null
  }
  {
    dismissible ? (
      <button
        type="button"
        {...mergeProps(b.dismiss)}
        aria-label={dismissLabel}
        data-var-ui-banner-dismiss
        set:html={closeSvg}
      />
    ) : null
  }
</div>

{
  dismissible ? (
    <script>
      import { initDismissibleBanner } from '../scripts/bannerDismiss';
      initDismissibleBanner();
    </script>
  ) : null
}
