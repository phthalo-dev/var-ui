---
import { layoutHeader } from '@var-ui/core/components/layout';
import { layoutShellPaddingAssignments } from '@var-ui/core/components/layoutShellVars';
import type { LayoutPadding } from '@var-ui/core';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from '../utils';
import { mergeInlineStyle } from '../lib/mergeInlineStyle';

type Props = Omit<HTMLAttributes<'div'>, 'class:list'> & {
  hasDivider?: boolean;
  height?: number | string;
  padding?: LayoutPadding;
  className?: string;
};

function toCssSize(value: number | string | undefined): string | undefined {
  if (value == null) return undefined;
  return typeof value === 'number' ? `${value}px` : value;
}

function zoneOverrideStyle(
  height: number | string | undefined,
  padding: LayoutPadding | undefined,
): Record<string, string> | undefined {
  const heightValue = toCssSize(height);
  if (heightValue == null && padding == null) return undefined;
  const paddingVars = padding == null ? undefined : layoutShellPaddingAssignments(padding);
  return {
    ...(heightValue != null ? { height: heightValue } : {}),
    ...paddingVars,
  };
}

const { hasDivider = false, height, padding, className, style: styleProp, ...rest } = Astro.props;
const s = layoutHeader();
const style = mergeInlineStyle(zoneOverrideStyle(height, padding), styleProp);
---

<div {...rest} {...mergeProps(s.header, className)} style={style} data-divider={hasDivider ? '' : undefined}>
  <div {...mergeProps(s.headerInner)}><slot /></div>
</div>
