---
import type { HTMLAttributes } from 'astro/types';
import { collapsible } from '@var-ui/core/components/collapsible';
import type { CollapsibleVariantProps } from '@var-ui/core';
import { svg as chevronDownSvg } from '@var-ui/icons/glyphs/chevronDown';
import { mergeProps } from '../utils';

interface Props extends Omit<HTMLAttributes<'details'>, 'id' | 'title'>, CollapsibleVariantProps {
  id?: string;
  title?: string;
  defaultExpanded?: boolean;
  /** Hides the default chevron on the title trigger. */
  hideIcon?: boolean;
  className?: string;
}

const {
  id,
  title,
  defaultExpanded = false,
  hideIcon = false,
  variant = 'flush',
  className,
  ...rest
} = Astro.props;

const c = collapsible({ variant });
const hasTriggerSlot = Astro.slots.has('trigger');
const hasIconSlot = Astro.slots.has('icon');
---

<details {...rest} id={id} open={defaultExpanded || undefined} {...mergeProps(c.root, className)}>
  <summary {...mergeProps(c.trigger)}>
    {
      hasTriggerSlot ? (
        <>
          {hasIconSlot && <span {...mergeProps(c.triggerIcon)}><slot name="icon" /></span>}
          <slot name="trigger" />
        </>
      ) : (
        <>
          {!hideIcon && <span {...mergeProps(c.triggerIcon)} set:html={chevronDownSvg} />}
          {title}
        </>
      )
    }
  </summary>
  <div {...mergeProps(c.panel)}>
    <slot />
  </div>
</details>
