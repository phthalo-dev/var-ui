---
import { collapsible, type CollapsibleVariantProps } from '@var-ui/core';
import { defaultIconSvgs } from '@var-ui/icons/glyphs';
import { mergeProps } from '../utils';

interface Props extends CollapsibleVariantProps {
  id?: string;
  title?: string;
  defaultExpanded?: boolean;
  className?: string;
}

const {
  id,
  title,
  defaultExpanded = false,
  variant = 'flush',
  className,
} = Astro.props;

const c = collapsible({ variant });
const hasTriggerSlot = Astro.slots.has('trigger');
---

<details id={id} open={defaultExpanded || undefined} {...mergeProps(c.root, className)}>
  <summary {...mergeProps(c.trigger)}>
    {
      hasTriggerSlot ? (
        <slot name="trigger" />
      ) : (
        <>
          <span {...mergeProps(c.triggerIcon)} set:html={defaultIconSvgs.chevronDown} />
          {title}
        </>
      )
    }
  </summary>
  <div {...mergeProps(c.panel)}>
    <slot />
  </div>
</details>
