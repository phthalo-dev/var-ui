---
import type { ControlSize } from '@var-ui/core';
import type { HTMLAttributes } from 'astro/types';
import SegmentedControl from '../components/SegmentedControl.astro';

type ColorModeToggleAppearance = "icons" | "labels" | "iconsAndLabels";

type Props = Omit<HTMLAttributes<'div'>, 'class:list' | 'role'> & {
  includeSystem?: boolean;
  appearance?: ColorModeToggleAppearance;
  size?: ControlSize;
  className?: string;
  "aria-label"?: string;
  storageKey?: string;
  /** Text of each segment. @default { light: 'Light', dark: 'Dark', system: 'System' } */
  labels?: Partial<Record<'light' | 'dark' | 'system', string>>;
};

const {
  includeSystem = false,
  appearance = "icons",
  size = "md",
  className,
  "aria-label": ariaLabel = "Color mode",
  storageKey = "theme-mode",
  labels,
  ...rest
} = Astro.props;

const modes = includeSystem
  ? (["light", "dark", "system"] as const)
  : (["light", "dark"] as const);
const MODE_META = {
  light: { label: labels?.light ?? "Light", icon: "colorModeLight" },
  dark: { label: labels?.dark ?? "Dark", icon: "colorModeDark" },
  system: { label: labels?.system ?? "System", icon: "colorModeSystem" },
} as const;

// `icon` layout shows only the icon and names the segment with its label.
const options = modes.map((mode) => ({
  value: mode,
  label: MODE_META[mode].label,
  ...(appearance === "labels" ? {} : { icon: MODE_META[mode].icon }),
}));
---

{/*
  Same radio group as `SegmentedControl` (and React's `ColorModeToggle`). Nothing is checked in
  the HTML: the stored preference is only known on the client, which checks it on load.
*/}
<SegmentedControl
  {...rest}
  options={options}
  defaultValue=""
  size={size}
  layout={appearance === "icons" ? "icon" : "default"}
  className={className}
  aria-label={ariaLabel}
  data-var-ui-color-mode-toggle
  data-include-system={includeSystem ? "true" : "false"}
  data-storage-key={storageKey}
/>


<script>
  import { initColorModeToggle } from "../scripts/colorMode";
  initColorModeToggle();
  document.addEventListener("astro:page-load", () => initColorModeToggle());
</script>
