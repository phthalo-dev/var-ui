---
import { icon } from '@var-ui/core/components/icon';
import { segmentedControl } from '@var-ui/core/components/segmentedControl';
import { toggleButton } from '@var-ui/core/components/toggleButton';
import type { SegmentedControlVariantProps } from '@var-ui/core';
import { svg as colorModeDark } from '@var-ui/icons/glyphs/colorModeDark';
import { svg as colorModeLight } from '@var-ui/icons/glyphs/colorModeLight';
import { svg as colorModeSystem } from '@var-ui/icons/glyphs/colorModeSystem';
import type { HTMLAttributes } from 'astro/types';
import { mergeProps } from "../utils";

type ColorModeToggleAppearance = "icons" | "labels" | "iconsAndLabels";

type Props = Omit<HTMLAttributes<'div'>, 'class:list'> & {
  includeSystem?: boolean;
  appearance?: ColorModeToggleAppearance;
  size?: NonNullable<SegmentedControlVariantProps['size']>;
  className?: string;
  "aria-label"?: string;
  storageKey?: string;
  /** Text of each segment. @default { light: 'Light', dark: 'Dark', system: 'System' } */
  labels?: Partial<Record<'light' | 'dark' | 'system', string>>;
};

const {
  includeSystem = false,
  appearance = "icons",
  size = "md",
  className,
  "aria-label": ariaLabel = "Color mode",
  storageKey = "theme-mode",
  labels,
  ...rest
} = Astro.props;

const modes = includeSystem
  ? (["light", "dark", "system"] as const)
  : (["light", "dark"] as const);
const s = segmentedControl({ size });
const t = toggleButton({ segmented: true });
const i = icon({ size: size === "lg" ? "lg" : size === "sm" ? "sm" : "md" });
const buttonRecipe = mergeProps(t);
const iconRecipe = mergeProps(i);

const MODE_META = {
  light: { label: labels?.light ?? "Light", icon: colorModeLight },
  dark: { label: labels?.dark ?? "Dark", icon: colorModeDark },
  system: { label: labels?.system ?? "System", icon: colorModeSystem },
};
---

<div
  role="group"
  {...rest}
  aria-label={ariaLabel}
  {...mergeProps(s.root, className)}
  data-var-ui-color-mode-toggle
  data-include-system={includeSystem ? "true" : "false"}
  data-storage-key={storageKey}
>
  {modes.map((mode) => {
    const meta = MODE_META[mode];
    const ariaLabelProp =
      appearance === "icons" ? { "aria-label": meta.label } : {};
    return (
      <button
        type="button"
        data-color-mode-value={mode}
        aria-pressed="false"
        {...buttonRecipe}
        {...ariaLabelProp}
      >
        {appearance === "labels" ? (
          meta.label
        ) : appearance === "iconsAndLabels" ? (
          <>
            <span {...iconRecipe} set:html={meta.icon} />
            {meta.label}
          </>
        ) : (
          <span {...iconRecipe} set:html={meta.icon} />
        )}
      </button>
    );
  })}
</div>

<script>
  import { initColorModeToggle } from "../scripts/colorMode";
  initColorModeToggle();
</script>
