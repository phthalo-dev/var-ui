---
import { icon, segmentedControl, toggleButton, type SegmentedControlVariantProps, } from "@var-ui/core";
import { defaultIconSvgs } from '@var-ui/icons/glyphs';
import { mergeProps } from "../utils";

type ColorModeToggleAppearance = "icons" | "labels" | "iconsAndLabels";

type Props = {
  includeSystem?: boolean;
  appearance?: ColorModeToggleAppearance;
  size?: NonNullable<SegmentedControlVariantProps['size']>;
  className?: string;
  "aria-label"?: string;
  storageKey?: string;
};

const {
  includeSystem = false,
  appearance = "icons",
  size = "md",
  className,
  "aria-label": ariaLabel = "Color mode",
  storageKey = "theme-mode",
} = Astro.props;

const modes = includeSystem
  ? (["light", "dark", "system"] as const)
  : (["light", "dark"] as const);
const s = segmentedControl({ size });
const t = toggleButton({ segmented: true });
const i = icon({ size: size === "lg" ? "lg" : size === "sm" ? "sm" : "md" });
const buttonRecipe = mergeProps(t);
const iconRecipe = mergeProps(i);

const MODE_META = {
  light: { label: "Light", icon: "colorModeLight" },
  dark: { label: "Dark", icon: "colorModeDark" },
  system: { label: "System", icon: "colorModeSystem" },
} as const;
---

<div
  role="group"
  aria-label={ariaLabel}
  {...mergeProps(s.root, className)}
  data-var-ui-color-mode-toggle
  data-include-system={includeSystem ? "true" : "false"}
  data-storage-key={storageKey}
>
  {modes.map((mode) => {
    const meta = MODE_META[mode];
    const ariaLabelProp =
      appearance === "icons" ? { "aria-label": meta.label } : {};
    return (
      <button
        type="button"
        data-color-mode={mode}
        aria-pressed="false"
        {...buttonRecipe}
        {...ariaLabelProp}
      >
        {appearance === "labels" ? (
          meta.label
        ) : appearance === "iconsAndLabels" ? (
          <>
            <span {...iconRecipe} set:html={defaultIconSvgs[meta.icon]} />
            {meta.label}
          </>
        ) : (
          <span {...iconRecipe} set:html={defaultIconSvgs[meta.icon]} />
        )}
      </button>
    );
  })}
</div>

<script>
  import { initColorModeToggle } from "../scripts/colorMode";
  initColorModeToggle();
</script>
