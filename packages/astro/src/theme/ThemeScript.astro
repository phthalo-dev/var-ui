---
import { COLOR_MODE_ATTRIBUTE } from '@var-ui/core/theme-constants';
import {
  getColorModeInitScript,
  type ColorModePreference,
} from '@var-ui/core/color-mode-script';

type Props = {
  /** Theme class added to `<html>` before paint. */
  themeClass: string;
  /** `localStorage` key of the stored preference. @default theme-mode */
  storageKey?: string;
  /** Mode used when nothing valid is stored. @default system */
  defaultColorMode?: ColorModePreference;
};
const { themeClass, storageKey = 'theme-mode', defaultColorMode = 'system' } = Astro.props;
// The same script the React provider and the Vite plugin use (`@var-ui/core/color-mode-script`).
const initScript = getColorModeInitScript({
  storageKey,
  defaultColorMode,
  themeClassName: themeClass,
});
const colorModeAttribute = COLOR_MODE_ATTRIBUTE;
---
<meta name="color-scheme" content="light dark" />
<style is:inline>
  /* Must match `layers` in packages/core/src/runtime.ts */
  @layer reset, base, tokens, components, overrides, utilities;
</style>
<script is:inline set:html={initScript} />
<script is:inline define:vars={{ themeClass, colorModeAttribute }}>
  // View transitions swap in a fresh <html>: carry the resolved theme class and mode over
  // before it paints. (Nothing to re-read: the preference can't change mid-navigation.)
  if (!window.__varUiThemeNav) {
    window.__varUiThemeNav = true;
    document.addEventListener('astro:before-swap', (event) => {
      const from = document.documentElement;
      const to = event.newDocument.documentElement;
      to.classList.add(themeClass);
      const mode = from.getAttribute(colorModeAttribute);
      if (mode) to.setAttribute(colorModeAttribute, mode);
      else to.removeAttribute(colorModeAttribute);
    });
  }
</script>
