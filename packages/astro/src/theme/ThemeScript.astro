---
import { COLOR_MODE_ATTRIBUTE } from '@var-ui/core/theme-constants';

type Props = {
  themeClass: string;
  storageKey?: string;
};
const { themeClass, storageKey = 'theme-mode' } = Astro.props;
const colorModeAttribute = COLOR_MODE_ATTRIBUTE;
---
<meta name="color-scheme" content="light dark" />
<style is:inline>
  /* Must match `layers` in packages/core/src/runtime.ts */
  @layer reset, base, tokens, components, overrides, utilities;
</style>
<script is:inline define:vars={{ themeClass, storageKey, colorModeAttribute }}>
  function applyThemeTo(doc) {
    const root = doc.documentElement;
    const stored = localStorage.getItem(storageKey);
    root.classList.add(themeClass);
    root.style.colorScheme = '';
    if (stored === 'light' || stored === 'dark') {
      root.setAttribute(colorModeAttribute, stored);
    } else {
      root.removeAttribute(colorModeAttribute);
    }
  }

  applyThemeTo(document);

  const navKey = `__varUiThemeNav:${storageKey}`;
  if (!window[navKey]) {
    window[navKey] = true;
    document.addEventListener('astro:before-swap', (event) => {
      applyThemeTo(event.newDocument);
    });
    document.addEventListener('astro:after-swap', () => {
      applyThemeTo(document);
    });
  }
</script>
