{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
  "changelog": ["@changesets/changelog-github", { "repo": "phthalo-dev/var-ui" }],
  "commit": false,
  "fixed": [],
  "fixed": [
    [
      "@var-ui/astro",
      "@var-ui/cli",
      "@var-ui/core",
      "@var-ui/docs",
      "@var-ui/docs-components",
      "@var-ui/icons",
      "@var-ui/react"
    ]
  ],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "___experimentalUnsafeOptions_WILL_CHANGE_IN_PATCH": {
    "onlyUpdatePeerDependentsWhenOutOfRange": true
  },
  "ignore": [
    "@var-ui/example-vite-app",
    "@var-ui/example-astro-app",
    "@var-ui/example-astro-docs",
    "@var-ui/docs-site"
  ]
}
